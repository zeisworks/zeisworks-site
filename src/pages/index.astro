---
// Homepage: one long-scroll sales page for independent gym owners.
// Proof rules carried over from the previous build: no invented names, quotes,
// or numbers. Anything awaiting Jack's confirmation carries a <span class="confirm">.
import SiteLayout from '../layouts/SiteLayout.astro';
import AuditCta from '../components/AuditCta.astro';
import { OFFER } from '../data/offer';
import { LIFT } from '../data/lift-stl';

const flow = [
  { n: '01', k: 'Ad', title: 'The ad', body: 'Short, honest creative aimed at people within a few miles of your door. One offer: a free week.' },
  { n: '02', k: 'Page', title: 'The page', body: 'A fast page that loads on a phone in a second, answers the four questions every trial has, and asks for four fields.' },
  { n: '03', k: 'Text', title: 'The text', body: 'The lead lands in your system and the promise on the page is kept: a coach calls or texts within the hour.' },
  { n: '04', k: 'Survey', title: 'The survey', body: 'After they claim the pass, three taps tell you their goal, how often they train, and what has stopped them before.' },
  { n: '05', k: 'Visit', title: 'The visit', body: 'Your coach walks in knowing their name, their goal, and their sticking point. The first day is a conversation, not a tour.' },
  { n: '06', k: 'Member', title: 'The member', body: 'Every step is tracked back to the ad that started it, so you know what a member actually costs you.' },
];

const leaks = [
  { title: 'The trial lives in an inbox.', body: 'A form on a template site emails somebody. Nobody owns the reply. By the time it gets a response the prospect has picked a different gym.' },
  { title: 'The ad is judged on likes.', body: 'The pixel is not wired to the form, so the only number anyone sees is reach. Ad spend becomes a feeling instead of a cost per member.' },
  { title: 'The first visit is a tour.', body: 'The coach knows nothing about the person walking in. The visit is spent asking questions the page could have asked.' },
];

const deliverables = [
  'A free-week landing page on its own subdomain, built by hand, no template',
  'Ad creative and copy for Meta, plus the audience and the offer',
  'Meta Pixel and GA4 wired to the form, not just the page',
  'Leads routed into the system you already use, with the survey answers attached',
  'The follow-up script your coach sends in the first hour',
  'Real Google reviews on the page, kept current',
  'A one-page monthly read: leads, shows, members, cost per member',
];

const fit = [
  'You own one or two locations and you are on the floor most days',
  'Memberships are month to month and a free week is something you would offer',
  'Your reviews are good and nobody has put them to work',
  'You want to know what a member costs, not what a click costs',
];
const notFit = [
  'You want a franchise-wide brand campaign',
  'You are not willing to have a coach reply within the hour',
  'You want a chatbot instead of a person on the phone',
];

const faq = [
  { q: 'Do you run the ads, or just build the page?', a: `Both, if you want both. ${OFFER.run.name} includes the ads. If you already have someone running Meta, the page and the tracking work with what they do.` },
  { q: 'What do you need from us?', a: 'Access to your Meta business account and Google Business Profile, your logo and brand colors, a few photos of the floor, and a coach who will actually reply within the hour.' },
  { q: 'How fast does it go live?', a: `${OFFER.build.timeline}. The slow part is usually getting photos and approvals, not the build.` },
  { q: 'Do we own it?', a: 'Yes. The page, the domain, the ad account, the pixel, and every lead are yours. If you stop working with ZeisWorks, nothing turns off.' },
  { q: 'Is a free week really the right offer?', a: 'For a gym that is proud of its floor, yes. A day pass is a peek. A week is enough time for someone to build a habit and meet your coaches. The page is built to filter for locals who are serious.' },
];
---

<SiteLayout
  title="ZeisWorks — Free-week funnels for independent gyms"
  description="ZeisWorks builds the free-week funnel that turns strangers on Instagram into members on your floor: the page, the ads, the instant follow-up, and the numbers. Built for Lift-STL in Brentwood, Missouri."
  navTone="dark"
>
  <!-- ═══════ HERO ═══════ -->
  <section class="hero on-dark" aria-label="Introduction">
    <video class="hero-video" autoplay muted loop playsinline poster="/media/hero-gym-poster.webp" aria-hidden="true">
      <source src="/media/hero-gym.webm" type="video/webm" />
      <source src="/media/hero-gym.mp4" type="video/mp4" />
    </video>
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <p class="t-eyebrow mb-5">For independent gym owners</p>
      <h1 class="t-display mb-6">
        Your first week<br />
        <span class="hero-accent">should sell</span><br />
        the membership.
      </h1>
      <p class="t-lede measure mb-9" style="color: rgba(244,242,237,0.82);">
        We build the free-week funnel that turns strangers on Instagram into members on your floor.
        The page, the ads, the follow-up, and the numbers. Built for Lift-STL in Brentwood, Missouri.
        Built for gyms like yours.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 mb-10">
        <AuditCta location="hero" label="Get my free-week plan" class="btn btn-red" />
        <a href="/lift-stl/" class="btn btn-ghost">See the Lift-STL build</a>
      </div>
      <ul class="hero-proof" aria-label="Proof">
        <li><span class="dot"></span>Live at join.lift-stl.com</li>
        <li><span class="dot"></span>Coach replies within the hour</li>
        <li><span class="dot"></span>{LIFT.rating}★ on {LIFT.reviewCount} Google reviews</li>
      </ul>
    </div>
  </section>

  <!-- ═══════ FLOW STRIP ═══════ -->
  <div class="strip on-dark" aria-hidden="true">
    <div class="strip-track">
      {[0, 1].map(() => (
        <span class="strip-run">
          {flow.map((f) => <span class="strip-item"><span class="strip-key">{f.k}</span><span class="strip-arrow">→</span></span>)}
        </span>
      ))}
    </div>
  </div>

  <!-- ═══════ THE LEAK ═══════ -->
  <section id="leak" class="section anchor">
    <div class="wrap">
      <div class="measure-wide">
        <p class="t-eyebrow mb-4">Where trials go to die</p>
        <h2 class="t-h2 mb-6">Most gyms already have a free trial. Most of them leak.</h2>
        <p class="t-lede t-muted mb-12">The offer is fine. The problem is everything between the ad and the handshake.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-px rounded-[14px] overflow-hidden border" style="background: var(--line); border-color: var(--line);">
        {leaks.map((l, i) => (
          <article class="p-7" style="background: var(--paper-2);">
            <p class="t-mono text-xs mb-4" style="color: var(--red);">0{i + 1}</p>
            <h3 class="t-h3 mb-3">{l.title}</h3>
            <p class="text-[0.95rem] t-muted leading-relaxed m-0">{l.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════ THE SYSTEM ═══════ -->
  <section id="system" class="section anchor rule-t">
    <div class="wrap">
      <div class="grid lg:grid-cols-[1.05fr_0.95fr] gap-12 lg:gap-16 items-start">
        <div>
          <p class="t-eyebrow mb-4">The system</p>
          <h2 class="t-h2 mb-6">Six steps. One number at the end.</h2>
          <p class="t-lede t-muted mb-10 measure">Every step exists to make the next one easier. Every step is measured. The last one is the only one that matters.</p>
          <ol class="flow-list">
            {flow.map((f) => (
              <li class="flow-item">
                <span class="t-mono flow-n">{f.n}</span>
                <div>
                  <h3 class="t-h3 mb-1">{f.title}</h3>
                  <p class="text-[0.95rem] t-muted leading-relaxed m-0">{f.body}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
        <div class="lg:sticky lg:top-24">
          <div class="phone-stage">
            <figure class="phone">
              <div class="phone-notch" aria-hidden="true"></div>
              <div class="phone-screen">
                <img src="/media/lift-mobile-full.webp" alt="The Lift-STL free 7-day pass page on a phone, scrolling from the headline through the claim form." width="780" height="14388" loading="lazy" />
              </div>
            </figure>
            <figcaption class="t-mono text-xs t-muted mt-4 text-center">The live Lift-STL page. Scrolls on its own; hover to pause.</figcaption>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════ CASE STUDY ═══════ -->
  <section id="proof" class="section anchor on-dark">
    <div class="wrap">
      <div class="grid lg:grid-cols-2 gap-12 items-end mb-12">
        <div>
          <p class="t-eyebrow mb-4">Built for a real gym</p>
          <h2 class="t-h2 mb-6">Lift-STL, Brentwood, Missouri.</h2>
          <p class="t-lede t-muted measure">
            Eric Humes opened Lift in 2020 with an SBA loan and a plan. Six years and {LIFT.reviewCount} Google reviews later, the gym
            needed a front door that matched the floor. So we built one.
          </p>
        </div>
        <div class="flex flex-wrap gap-2 lg:justify-end">
          <span class="chip">Free 7-day pass</span>
          <span class="chip">Coach in &lt;1 hr</span>
          <span class="chip">Pixel + GA4 wired</span>
          <span class="chip">Leads into their CRM</span>
          <span class="chip chip-red">Live now</span>
        </div>
      </div>

      <div class="browser">
        <div class="browser-bar" aria-hidden="true">
          <span class="dot"></span><span class="dot"></span><span class="dot"></span>
          <span class="browser-url t-mono">join.lift-stl.com</span>
        </div>
        <div class="browser-body">
          <img src="/media/lift-desktop-full.webp" alt="The full Lift-STL free-week page on desktop: headline, stats strip, feature cards, Google reviews, FAQ, map, and the claim form." width="1200" height="4572" loading="lazy" />
        </div>
      </div>

      <div class="grid md:grid-cols-3 gap-5 mt-10">
        {LIFT.facts.map((f) => (
          <div class="card-dark">
            <p class="t-num mb-2">{f.value}</p>
            <p class="t-mono text-xs uppercase tracking-widest t-muted m-0">{f.label}</p>
          </div>
        ))}
      </div>
      <div class="card-dark mt-5 flex flex-col sm:flex-row sm:items-center gap-5 justify-between">
        <p class="m-0 t-muted text-[0.95rem]">
          <span class="confirm mr-2">confirm</span>
          Leads, show rate, and cost per member go here once Jack signs off on the numbers. Nothing on this page is invented.
        </p>
        <a href="/lift-stl/" class="btn btn-paper shrink-0">Read the full build</a>
      </div>
    </div>
  </section>

  <!-- ═══════ WHAT YOU GET ═══════ -->
  <section id="deliverables" class="section anchor">
    <div class="wrap grid lg:grid-cols-[0.9fr_1.1fr] gap-12 lg:gap-16 items-center">
      <div class="img-frame">
        <img src="/media/front-desk.webp" alt="A coach greeting a first-time visitor at the front desk of an independent gym." width="1600" height="1067" loading="lazy" />
      </div>
      <div>
        <p class="t-eyebrow mb-4">What you get</p>
        <h2 class="t-h2 mb-8">Everything between the ad and the handshake.</h2>
        <ul class="check-list">
          {deliverables.map((d) => <li>{d}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- ═══════ FIT ═══════ -->
  <section id="fit" class="section anchor rule-t">
    <div class="wrap">
      <div class="measure-wide mb-12">
        <p class="t-eyebrow mb-4">Who it's for</p>
        <h2 class="t-h2">Built for the owner who is on the floor.</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-5">
        <div class="card">
          <p class="t-mono text-xs uppercase tracking-widest mb-5" style="color: var(--red);">Good fit</p>
          <ul class="space-y-3">{fit.map((x) => <li class="fit-yes text-[0.95rem]">{x}</li>)}</ul>
        </div>
        <div class="card" style="background: var(--paper-3); border-style: dashed;">
          <p class="t-mono text-xs uppercase tracking-widest t-muted mb-5">Not a fit</p>
          <ul class="space-y-3">{notFit.map((x) => <li class="fit-no text-[0.95rem] t-muted">{x}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════ PRICING ═══════ -->
  <section id="pricing" class="section anchor on-dark">
    <div class="wrap">
      <div class="measure-wide mb-12">
        <p class="t-eyebrow mb-4">Pricing</p>
        <h2 class="t-h2 mb-6">Three steps. Each one optional until you've seen the last.</h2>
        <p class="t-lede t-muted">No contract. You keep the page, the ad account, and every lead at every step.</p>
      </div>
      <ol class="grid md:grid-cols-3 gap-5">
        {[OFFER.teardown, OFFER.build, OFFER.run].map((s, i) => (
          <li class="card-dark flex flex-col">
            <span class="t-mono text-sm mb-4" style="color: var(--red-soft);">0{i + 1}</span>
            <h3 class="t-h3 mb-1">{s.name}</h3>
            <p class="t-mono text-sm t-muted mb-4">
              {s.price ?? <span><span class="confirm">confirm</span> price</span>}{s.terms ? ` · ${s.terms}` : ''}
            </p>
            <p class="text-[0.95rem] t-muted leading-relaxed flex-1 m-0">{s.body}</p>
          </li>
        ))}
      </ol>
      <div class="mt-10 flex flex-col sm:flex-row sm:items-center gap-5">
        <AuditCta location="mid" label="Start with the free teardown" class="btn btn-red" />
        <p class="t-muted text-sm m-0">Fifteen minutes. You'll leave knowing where your current trial leaks.</p>
      </div>
    </div>
  </section>

  <!-- ═══════ FOUNDER ═══════ -->
  <section id="founder" class="section anchor">
    <div class="wrap grid md:grid-cols-[auto_1fr] gap-8 md:gap-12 items-start">
      <img src="/jack.jpg" alt="Jack Zeis" class="founder-photo" width="220" height="220" loading="lazy" />
      <div class="measure-wide">
        <p class="t-eyebrow mb-4">Who does the work</p>
        <h2 class="t-h2 mb-6">One person builds it. The same person answers the phone.</h2>
        <p class="t-muted mb-4">
          ZeisWorks is Jack Zeis, a systems consultant in Golden, Colorado. He has spent a decade building the things businesses run on:
          search, websites, CRMs, tracking, and the connective tissue between them. Lift-STL's free-week page is his build, start to finish.
        </p>
        <p class="t-muted mb-6">
          No agency. No account manager. No junior team you've never met. If it isn't producing members, you shouldn't pay for the next month, and you won't have to.
        </p>
        <a href="https://www.upwork.com/freelancers/~01ddd112c03a2e1428" rel="noopener" target="_blank" class="chip">★ 5.0 on Upwork · Top Rated · 100% Job Success ↗</a>
      </div>
    </div>
  </section>

  <!-- ═══════ FAQ ═══════ -->
  <section id="faq" class="section anchor rule-t">
    <div class="wrap grid lg:grid-cols-[0.8fr_1.2fr] gap-10">
      <div>
        <p class="t-eyebrow mb-4">Questions</p>
        <h2 class="t-h2">The ones every owner asks.</h2>
      </div>
      <div class="divide-y" style="border-color: var(--line);">
        {faq.map((f) => (
          <details class="faq-item">
            <summary class="t-h3">{f.q}<span class="faq-plus" aria-hidden="true">+</span></summary>
            <p class="t-muted text-[0.95rem] leading-relaxed mt-3 mb-5">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════ FINAL CTA ═══════ -->
  <section id="start" class="final on-dark anchor">
    <img src="/media/gym-floor.webp" alt="" aria-hidden="true" class="final-bg" loading="lazy" />
    <div class="final-shade" aria-hidden="true"></div>
    <div class="wrap final-inner">
      <p class="t-eyebrow mb-4">Get started</p>
      <h2 class="t-h1 mb-6">Fill the floor.</h2>
      <p class="t-lede mb-9 measure" style="color: rgba(244,242,237,0.82);">
        Answer four questions about your gym and get a free-week plan back: the offer, the page, the follow-up, and what it should cost you per member.
      </p>
      <AuditCta location="footer" label="Get my free-week plan" class="btn btn-red" />
    </div>
  </section>
</SiteLayout>

<style is:global>
  /* ── Hero ── */
  .hero { position: relative; min-height: 100svh; display: flex; align-items: flex-end; overflow: hidden; overflow-x: clip; }
  .hero-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.85; }
  .hero-shade { position: absolute; inset: 0; background:
    linear-gradient(180deg, rgba(14,14,16,0.55) 0%, rgba(14,14,16,0.25) 40%, rgba(14,14,16,0.92) 100%),
    linear-gradient(90deg, rgba(14,14,16,0.6) 0%, rgba(14,14,16,0) 60%); }
  .hero-inner { position: relative; padding-top: 8rem; padding-bottom: clamp(3rem, 7vw, 6rem); }
  .hero-accent { color: var(--red); }
  .hero-proof { display: flex; flex-wrap: wrap; gap: 0.6rem 1.6rem; margin: 0; padding: 0; list-style: none; font-family: var(--mono); font-size: 0.74rem; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(244,242,237,0.7); }
  .hero-proof li { display: inline-flex; align-items: center; gap: 0.55rem; }
  .hero-proof .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--red); }

  /* ── Marquee strip ── */
  .strip { overflow: hidden; border-top: 1px solid var(--line-dark); border-bottom: 1px solid var(--line-dark); padding-block: 0.9rem; }
  .strip-track { display: flex; width: max-content; animation: strip 28s linear infinite; }
  .strip-run { display: flex; }
  .strip-item { display: inline-flex; align-items: center; gap: 1.2rem; padding-inline: 0.6rem; white-space: nowrap; }
  .strip-key { font-family: var(--display); font-variation-settings: 'wdth' 78; font-weight: 800; text-transform: uppercase; font-size: clamp(1.4rem, 2.6vw, 2rem); letter-spacing: 0.01em; }
  .strip-arrow { color: var(--red); font-family: var(--mono); font-size: 1.2rem; }
  @keyframes strip { to { transform: translateX(-50%); } }

  /* ── Flow list ── */
  .flow-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.4rem; }
  .flow-item { display: grid; grid-template-columns: 3rem 1fr; gap: 0.5rem; padding-top: 1.2rem; border-top: 1px solid var(--line); }
  .flow-n { color: var(--red); font-size: 0.85rem; padding-top: 0.3rem; }

  /* ── Phone with auto-scrolling screenshot ── */
  .phone-stage { display: flex; flex-direction: column; align-items: center; }
  .phone { --pw: min(340px, 84vw); margin: 0; width: var(--pw); height: calc(var(--pw) * 19 / 9); background: #0a0a0b; border-radius: 44px; padding: 12px; box-shadow: 0 30px 80px rgba(14,14,16,0.35), inset 0 0 0 2px rgba(255,255,255,0.08); position: relative; box-sizing: border-box; }
  .phone-notch { position: absolute; top: 20px; left: 50%; transform: translateX(-50%); width: 96px; height: 26px; background: #0a0a0b; border-radius: 999px; z-index: 2; }
  .phone-screen { width: 100%; height: 100%; border-radius: 34px; overflow: hidden; background: #F3F1EC; position: relative; container-type: size; }
  .phone-screen img { display: block; width: 100%; height: auto; position: absolute; top: 0; left: 0; animation: phone-scroll 34s ease-in-out infinite alternate; }
  .phone:hover .phone-screen img { animation-play-state: paused; }
  @keyframes phone-scroll { 0% { transform: translateY(0); } 8% { transform: translateY(0); } 100% { transform: translateY(calc(-100% + 100cqh)); } }

  /* ── Browser frame ── */
  .browser { border-radius: 14px; overflow: hidden; border: 1px solid var(--line-dark); background: #0a0a0b; box-shadow: 0 40px 100px rgba(0,0,0,0.5); }
  .browser-bar { display: flex; align-items: center; gap: 6px; padding: 0.7rem 1rem; background: #17171B; border-bottom: 1px solid var(--line-dark); }
  .browser-bar .dot { width: 10px; height: 10px; border-radius: 50%; background: rgba(255,255,255,0.18); }
  .browser-url { margin-left: 0.8rem; font-size: 0.72rem; color: rgba(244,242,237,0.6); background: rgba(255,255,255,0.06); padding: 0.25rem 0.7rem; border-radius: 6px; }
  .browser-body { max-height: 560px; overflow: hidden; position: relative; }
  .browser-body img { display: block; width: 100%; height: auto; animation: browser-scroll 40s ease-in-out infinite alternate; }
  .browser:hover .browser-body img { animation-play-state: paused; }
  @keyframes browser-scroll { 0% { transform: translateY(0); } 10% { transform: translateY(0); } 100% { transform: translateY(calc(-100% + 560px)); } }
  .browser-body::after { content: ''; position: absolute; inset: auto 0 0 0; height: 90px; background: linear-gradient(180deg, transparent, rgba(14,14,16,0.85)); pointer-events: none; }

  /* ── Misc ── */
  .img-frame { border-radius: 14px; overflow: hidden; border: 1px solid var(--line); }
  .img-frame img { display: block; width: 100%; height: auto; }
  .check-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.8rem; }
  .check-list li { display: grid; grid-template-columns: 1.6rem 1fr; gap: 0.4rem; font-size: 0.98rem; }
  .check-list li::before { content: '✓'; color: var(--red); font-family: var(--mono); font-weight: 600; }
  .fit-yes::before { content: '→ '; color: var(--red); font-family: var(--mono); }
  .fit-no::before { content: '· '; font-family: var(--mono); }
  .founder-photo { width: 220px; height: 220px; object-fit: cover; border-radius: 16px; border: 1px solid var(--line); }
  .faq-item summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding-block: 1.2rem; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-plus { font-family: var(--mono); color: var(--red); font-weight: 400; transition: transform 0.25s var(--ease); }
  .faq-item[open] .faq-plus { transform: rotate(45deg); }

  .final { position: relative; overflow: hidden; }
  .final-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.55; }
  .final-shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(14,14,16,0.95) 0%, rgba(14,14,16,0.6) 60%, rgba(14,14,16,0.3) 100%); }
  .final-inner { position: relative; padding-block: clamp(6rem, 12vw, 10rem); }

  @media (prefers-reduced-motion: reduce) {
    .strip-track, .phone-screen img, .browser-body img { animation: none !important; }
  }
</style>
