---
import LandingLayout from '../layouts/LandingLayout.astro';
import { Image } from 'astro:assets';
import heroFlow from '../assets/hero-flow.png';
import AuditCta from '../components/AuditCta.astro';
import FileExplorer from '../components/FileExplorer.astro';
import QueryDemo from '../components/QueryDemo.astro';
import OfferLadder from '../components/OfferLadder.astro';
import Testimonials from '../components/Testimonials.astro';
import { HOME_QUERY_PRESETS } from '../data/query-demo';
import { CASE_STUDIES } from '../data/case-studies';

const navLinks = [
  { label: 'Problem', href: '#the-problem' },
  { label: 'Demo', href: '#demo' },
  { label: 'How it works', href: '#how-it-works' },
  { label: 'Fit', href: '#fit' },
  { label: 'Pricing', href: '#pricing' },
];

const knowledgeFiles = ['pricing.md', 'estimating.md', 'customers.md', 'escalation.md', 'brand-voice.md', 'policies.md'];

const problems = [
  { title: 'Everything runs through one person', body: 'The owner, senior estimator, or operations lead keeps getting interrupted because the real answers live with them.' },
  { title: 'Your AI gives plausible answers, not company answers', body: "ChatGPT knows the internet. It does not know your pricing logic, escalation rules, customer red flags, or proposal standards." },
  { title: 'Training takes forever', body: 'New employees learn through shadowing, repeated questions, and a long trail of small exceptions nobody has written down.' },
  { title: 'Important rules are scattered everywhere', body: "Some rules are in SOPs. Some are in spreadsheets. Some are in Slack. The decisive ones may only exist in someone's head." },
  { title: 'You have key-person risk', body: 'When one experienced employee leaves, the company can lose the judgment behind years of pricing, sales, and operations decisions.' },
  { title: 'You want AI, but do not trust it', body: 'The issue is rarely the model alone. It is that the model has not been taught how your company actually operates.' },
];

// Sample company files behind the demo. Illustrative placeholders (labeled as
// such in the UI); every demo answer derives from lines visible here.
const routes = [
  { key: 'pricing', path: 'reference/pricing.md', lines: ['# Pricing', 'We price by the project, not the hour.', 'A quote holds for 30 days.', 'Standard rates live in the rate table.'] },
  { key: 'approvals', path: 'reference/approval-rules.md', lines: ['# Approval rules', 'Discounts to 10%: account manager.', 'Discounts 11–20%: sales manager.', 'Refunds past policy: owner sign-off.'] },
  { key: 'customers', path: 'reference/customers.md', lines: ['# Customers', 'Good fit: repeat work, clear scope.', 'Red flags: urgent timeline, scope disputes.', 'Red-flag accounts: prepay or manager ok.'] },
  { key: 'refunds', path: 'reference/refund-policy.md', lines: ['# Refund policy', 'window: 30 days from delivery', 'exceptions: final-sale, custom orders', 'after 30 days: store credit only'] },
  { key: 'escalation', path: 'working/handoffs.md', lines: ['# Escalation', 'Loop in a human for money or complaints.', 'Tag the owner within one business day.', 'Never guess on legal or refunds.'] },
];

const coreKnowledge = ['Rules', 'Exceptions', 'Judgment', 'Processes', 'Pricing logic', 'Customer definitions', 'Escalation paths', 'Brand voice', 'Institutional memory'];

const beforeItems = ['Senior employees answer the same questions repeatedly', 'Pricing knowledge is inconsistent', 'AI produces generic responses', 'SOPs go stale', "Critical judgment exists only in people's heads", 'Automations break when exceptions occur'];
const afterItems = ['Employees can query company knowledge', 'AI follows real pricing logic', 'Answers reference actual company rules', 'Institutional knowledge is explicit', 'New hires have an internal knowledge system', 'Updates happen at the knowledge layer'];

const exampleCaptured = ['Pricing logic and common exceptions', 'Customer qualification criteria', 'Proposal structure and approved language', 'Escalation rules for edge cases', 'Role-specific operating notes for new hires'];
const exampleBuilt = ['An internal question-answering system with source references', 'A pricing and scope reference for estimators', 'A proposal draft workflow using company language', 'A living file structure the team can review and update'];

const outcomes = [
  { title: 'Sales', items: ['Lead qualification', 'Proposal drafting', 'Customer research', 'Follow-up', 'Pricing guidance'] },
  { title: 'Operations', items: ['Process Q&A', 'Escalation guidance', 'Internal support', 'Decision assistance', 'Workflow automation'] },
  { title: 'Training', items: ['New hire onboarding', 'Role-specific assistants', 'Process explanations', 'Internal knowledge search'] },
  { title: 'Estimating', items: ['Pricing guidance', 'Scope assistance', 'Historical context', 'Exception handling'] },
  { title: 'Customer service', items: ['Policy-aware responses', 'Escalation', 'Account context', 'Consistent answers'] },
];

const ownershipRows = [
  ['Knowledge hidden inside a platform', 'Knowledge stored in readable files'],
  ['Consultant understands the system', 'Your team can understand the system'],
  ['Dependent on one AI provider', 'AI-provider independent'],
  ['Black-box answers', 'Traceable source material'],
  ['Leave the vendor, lose the system', 'Leave ZeisWorks, keep the system'],
  ['Automation first', 'Knowledge first'],
];

const processSteps = [
  { n: '01', title: 'Map', body: 'Identify where the important knowledge currently lives: people, documents, software, spreadsheets, and processes.' },
  { n: '02', title: 'Capture', body: 'Interview the people who know how the business really operates, then document rules, exceptions, judgment, and decision logic.' },
  { n: '03', title: 'Build', body: 'Turn that knowledge into useful AI systems: assistants, internal search, estimating tools, proposal workflows, and automations.' },
  { n: '04', title: 'Transfer', body: 'Your company owns the knowledge, files, systems, and documentation. Continue if it creates value. Leave if it does not.' },
];

const greatFit = ['A few employees hold a disproportionate amount of important knowledge', 'Work involves judgment rather than simple checklists', 'You have meaningful exceptions and edge cases', 'Employees repeatedly ask the same internal questions', 'Training employees takes a long time', 'You want AI but do not trust generic output', 'Losing a senior employee would create serious problems'];
const notFit = ['You just need a simple chatbot', 'Your business processes are extremely standardized', 'Everything important is already documented and maintained', 'You only want AI because it is trendy', 'You expect AI to replace your team overnight'];
---

<LandingLayout
  title="ZeisWorks - Your company already knows the answer"
  description="ZeisWorks captures the rules, judgment, processes, and expertise inside your company, then turns that knowledge into AI systems your team can trust and own."
  ogImage="/og.png"
  navLinks={navLinks}
  ctaLabel="See your knowledge map"
>
  <span id="top" aria-hidden="true"></span>

  <!-- ═══════ HERO ═══════ -->
  <section class="zw-hero-split zw-hero-pad bg-zw-cream border-b border-zw-border" style="overflow-x: clip; padding-bottom: clamp(3rem, 6vw, 5rem);">
    <div class="zw-wrap px-5 sm:px-8 grid lg:grid-cols-[1fr_1.05fr] gap-12 lg:gap-14 items-center">
      <div>
        <p class="zw-eyebrow mb-4 zw-reveal" style="color: var(--zw-rust);">Institutional knowledge, made usable</p>
        <h1 class="zw-h1 text-zw-ink mb-6 zw-reveal">
          Your company already knows the answer.
          <em style="color: var(--zw-teal);">Your AI doesn't.</em>
        </h1>
        <p class="zw-lede mb-8 zw-reveal" style="max-width: 52ch;">
          ZeisWorks captures the pricing rules, processes, judgment, and expertise stuck inside
          your team — then turns them into AI your entire company can actually use.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 zw-reveal">
          <AuditCta location="hero" label="See what my company knows" class="inline-flex items-center justify-center gap-2 bg-zw-teal text-white font-semibold px-7 py-3.5 rounded-full hover:bg-zw-rust transition-colors" />
          <a href="#demo" class="inline-flex items-center justify-center px-7 py-3.5 rounded-full font-medium text-zw-ink border border-zw-ink/15 hover:bg-zw-ink/[0.04] transition-colors">Watch the knowledge demo</a>
        </div>
        <p class="mt-5 text-sm text-zw-muted zw-reveal">
          You own the knowledge. You own the systems. No proprietary AI platform required.
        </p>
      </div>
      <!-- Knowledge flow illustration: scattered inputs → plain files → capabilities -->
      <figure class="zw-hero-art zw-reveal m-0" data-anim="hero">
        <Image
          src={heroFlow}
          alt="Sticky notes, torn pages, a spreadsheet and a chat bubble funnel into a tidy stack of plain documents, and three arrows lead out of the stack."
          widths={[640, 960, 1280, 1920]}
          sizes="(min-width: 1024px) 560px, 100vw"
          loading="eager"
          fetchpriority="high"
          class="zw-hero-art-img"
        />
        <figcaption class="zw-hero-art-caption zw-mono" aria-hidden="true">
          <span style="--i:0">where it lives today</span>
          <span style="--i:1">plain files you own</span>
          <span style="--i:2">what your AI can now do</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ═══════ STRIP ═══════ -->
  <section class="zw-strip bg-zw-forest text-zw-cream">
    <div class="zw-wrap px-5 sm:px-8 text-center">
      <p class="zw-strip-line zw-reveal">
        The problem with your AI probably isn't the AI. It's what the AI knows about your company.
      </p>
    </div>
  </section>

  <!-- ═══════ PROBLEM ═══════ -->
  <section id="the-problem" class="zw-anchor zw-section">
    <div class="zw-wrap px-5 sm:px-8">
      <div class="zw-measure">
        <p class="zw-eyebrow mb-4 zw-reveal">Does this sound familiar?</p>
        <h2 class="zw-h2 mb-12 zw-reveal">The most valuable rules in the business are often the least accessible.</h2>
      </div>
      <!-- Hairline grid: parent bg shows through 1px gaps, no double borders. -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-px rounded-[12px] overflow-hidden border border-zw-border" style="background: var(--zw-border);">
        {problems.map((p) => (
          <article class="bg-white p-6 zw-reveal">
            <h3 class="zw-h2-sm mb-3">{p.title}</h3>
            <p class="text-sm text-zw-muted leading-relaxed">{p.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════ DEMO ═══════ -->
  <section id="demo" class="zw-anchor zw-section bg-zw-forest text-zw-cream">
    <div class="zw-wrap px-5 sm:px-8">
      <p class="zw-eyebrow zw-eyebrow-dark mb-4 zw-reveal">See it working</p>
      <h2 class="zw-h2 mb-8 max-w-[820px] zw-reveal text-zw-cream">
        A trustworthy answer has a trail back to company knowledge.
      </h2>
      <FileExplorer routes={routes} instanceId="home" theme="dark" lead="Sample company files — pick one to read it:">
        <QueryDemo slot="query" presets={HOME_QUERY_PRESETS} />
      </FileExplorer>
      <div class="mt-14 flex flex-col sm:flex-row sm:items-center gap-5 zw-reveal">
        <p class="text-zw-cream/85 font-medium m-0">Want this running on your files?</p>
        <AuditCta location="mid" label="See what my company knows" class="inline-flex items-center justify-center bg-zw-cream text-zw-forest font-semibold px-7 py-3.5 rounded-full hover:bg-white transition-colors self-start" />
      </div>
    </div>
  </section>

  <!-- ═══════ CORE IDEA + VIK ═══════ -->
  <section id="how-it-works" class="zw-anchor zw-section bg-white border-y border-zw-border">
    <div class="zw-wrap px-5 sm:px-8">
      <div class="zw-measure">
        <p class="zw-eyebrow mb-4 zw-reveal">The core idea</p>
        <h2 class="zw-h2 mb-8 zw-reveal">Before you automate the workflow, capture the judgment behind it.</h2>
        <p class="text-zw-muted mb-8 zw-reveal">
          Most AI projects start with the workflow. ZeisWorks starts with the knowledge behind the
          workflow. That includes:
        </p>
        <ul class="zw-chiprow zw-reveal">{coreKnowledge.map((c) => <li>{c}</li>)}</ul>
      </div>

      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center mt-14">
        <div>
          <p class="zw-eyebrow mb-4 zw-reveal">What we build</p>
          <h2 class="zw-h2 mb-8 zw-reveal">The finished knowledge system is your VIK.</h2>
          <p class="text-zw-muted mb-6 zw-reveal">
            <strong class="text-zw-ink font-semibold">Visualized Institutional Knowledge</strong> — a
            structured, human-readable representation of how your business thinks and operates. It
            becomes the source material behind your AI systems. And the client owns it.
          </p>
          <ol class="space-y-5 mt-8">
            {processSteps.map((s) => (
              <li class="zw-reveal flex gap-4">
                <span class="zw-mono text-zw-teal text-sm font-medium pt-1 shrink-0">{s.n}</span>
                <div>
                  <h3 class="zw-h3 mb-1">{s.title}</h3>
                  <p class="text-sm text-zw-muted leading-relaxed">{s.body}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
        <div class="zw-reveal">
          <figure class="zw-knowledge zw-mono m-0 max-w-[420px] mx-auto">
            <div class="zw-knowledge-bar">
              <span class="zw-dot"></span><span class="zw-dot"></span><span class="zw-dot"></span>
              <span class="ml-3 text-[0.72rem] zw-knowledge-name">your-company/</span>
              <span class="zw-sample-tag">yours to keep</span>
            </div>
            <ul class="zw-flow-files">{knowledgeFiles.map((f) => <li class="zw-kline">{f}</li>)}</ul>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════ BEFORE / AFTER ═══════ -->
  <section class="zw-anchor zw-section zw-rule-t">
    <div class="zw-wrap px-5 sm:px-8">
      <div class="zw-measure">
        <p class="zw-eyebrow mb-4 zw-reveal">Before and after</p>
        <h2 class="zw-h2 mb-12 zw-reveal">The same company, without the hidden bottleneck.</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-5">
        <div class="zw-card zw-compare-before zw-reveal">
          <p class="zw-mono text-xs uppercase tracking-widest text-zw-muted mb-5">Before ZeisWorks</p>
          <ul class="space-y-3">{beforeItems.map((x) => <li class="zw-compare-item-before text-sm text-zw-muted">{x}</li>)}</ul>
        </div>
        <div class="zw-card zw-reveal">
          <p class="zw-mono text-xs uppercase tracking-widest text-zw-teal mb-5">After ZeisWorks</p>
          <ul class="space-y-3">{afterItems.map((x) => <li class="zw-compare-item-after text-sm text-zw-ink">{x}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════ EXAMPLE ENGAGEMENT ═══════ -->
  <section class="zw-anchor zw-section bg-white border-y border-zw-border">
    <div class="zw-wrap px-5 sm:px-8">
      <div class="zw-measure">
        <p class="zw-eyebrow mb-4 zw-reveal">What an engagement looks like</p>
        <h2 class="zw-h2 mb-12 zw-reveal">From "ask the senior person" to a system the team can use.</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-12">
        <div class="zw-reveal">
          <h3 class="zw-h3 mb-5">What gets captured</h3>
          <ul class="space-y-4">{exampleCaptured.map((x) => <li class="flex gap-4"><span class="zw-mono text-zw-teal text-sm pt-0.5 shrink-0" aria-hidden="true">→</span><span class="text-sm text-zw-muted">{x}</span></li>)}</ul>
        </div>
        <div class="zw-reveal">
          <h3 class="zw-h3 mb-5">What can be built</h3>
          <ul class="space-y-4">{exampleBuilt.map((x) => <li class="flex gap-4"><span class="zw-mono text-zw-teal text-sm pt-0.5 shrink-0" aria-hidden="true">→</span><span class="text-sm text-zw-muted">{x}</span></li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════ OUTCOMES ═══════ -->
  <section class="zw-anchor zw-section zw-rule-t">
    <div class="zw-wrap px-5 sm:px-8">
      <div class="zw-measure">
        <p class="zw-eyebrow mb-4 zw-reveal">What it unlocks</p>
        <h2 class="zw-h2 mb-8 zw-reveal">Once the knowledge exists, the AI work gets easier.</h2>
        <p class="text-zw-muted mb-12 zw-reveal">Possibilities the knowledge foundation enables — not a promise that every client gets every system.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {outcomes.map((o) => (
          <article class="zw-card zw-reveal">
            <h3 class="zw-h3 mb-4">{o.title}</h3>
            <ul class="space-y-2">{o.items.map((x) => <li class="text-sm text-zw-muted">{x}</li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════ OWNERSHIP ═══════ -->
  <section id="ownership" class="zw-anchor zw-section bg-zw-forest text-zw-cream">
    <div class="zw-wrap px-5 sm:px-8">
      <p class="zw-eyebrow zw-eyebrow-dark mb-4 zw-reveal">What you own</p>
      <h2 class="zw-h2 mb-12 max-w-[820px] zw-reveal text-zw-cream">We don't want to own your AI. We want you to own it.</h2>
      <div class="overflow-x-auto zw-reveal">
        <table class="zw-owntable min-w-full">
          <thead>
            <tr>
              <th scope="col">Typical AI implementation</th>
              <th scope="col" class="zw-owntable-us">ZeisWorks</th>
            </tr>
          </thead>
          <tbody>
            {ownershipRows.map(([typical, zw]) => (
              <tr>
                <td>{typical}</td>
                <td class="zw-owntable-us">{zw}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="zw-mono text-xs mt-2 sm:hidden" style="color: rgba(245,245,247,0.5);">← swipe →</p>
      <p class="mt-10 text-zw-cream/85 font-medium max-w-[640px] zw-reveal">
        If ZeisWorks disappears tomorrow, the work we've done should still be useful to you.
      </p>
    </div>
  </section>

  <!-- ═══════ FIT ═══════ -->
  <section id="fit" class="zw-anchor zw-section">
    <div class="zw-wrap px-5 sm:px-8">
      <div class="zw-measure">
        <p class="zw-eyebrow mb-4 zw-reveal">Who it's for</p>
        <h2 class="zw-h2 mb-12 zw-reveal">ZeisWorks works best when your company runs on expertise.</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-12">
        <div class="zw-reveal">
          <h3 class="zw-h3 mb-5">Great fit if</h3>
          <ul class="space-y-4">{greatFit.map((x) => <li class="flex gap-4"><span class="zw-mono text-zw-teal text-sm pt-0.5 shrink-0" aria-hidden="true">→</span><span class="text-sm text-zw-muted">{x}</span></li>)}</ul>
        </div>
        <div class="zw-reveal">
          <h3 class="zw-h3 mb-5">Probably not a fit if</h3>
          <ul class="space-y-4">{notFit.map((x) => <li class="flex gap-4"><span class="zw-mono text-zw-muted text-sm pt-0.5 shrink-0" aria-hidden="true">·</span><span class="text-sm text-zw-muted">{x}</span></li>)}</ul>
        </div>
      </div>
      <p class="mt-12 text-sm text-zw-muted zw-reveal">
        Industry-specific pages: <a href="/for/consulting-firms/" class="font-medium text-zw-teal hover:underline">consulting firms</a> ·
        <a href="/for/agencies/" class="font-medium text-zw-teal hover:underline">agencies</a> ·
        <a href="/industries/" class="font-medium text-zw-teal hover:underline">all industries →</a>
      </p>
    </div>
  </section>

  <!-- ═══════ PROOF ═══════ -->
  <section id="proof" class="zw-anchor zw-section bg-white border-y border-zw-border">
    <div class="zw-wrap px-5 sm:px-8">
      <p class="zw-eyebrow mb-4 zw-reveal">What clients say</p>
      <h2 class="zw-h2 mb-8 zw-reveal">Real reviews from real work.</h2>
      <Testimonials tone="on-cream" />
      {CASE_STUDIES.length > 0 && (
        <a href="/results/#case-studies" class="zw-card zw-card-link zw-reveal mt-8 block max-w-[520px]">
          <p class="zw-eyebrow text-[0.7rem] mb-3">Case study</p>
          <h3 class="zw-h3 mb-2">{CASE_STUDIES[0].client}</h3>
          <p class="text-sm font-medium text-zw-teal">Read the case study →</p>
        </a>
      )}
      <p class="mt-8 text-sm text-zw-muted zw-reveal">
        <a href="/results/" class="font-medium text-zw-teal hover:underline">More proof →</a>
      </p>
    </div>
  </section>

  <!-- ═══════ PRICING ═══════ -->
  <section id="pricing" class="zw-anchor zw-section zw-rule-t">
    <div class="zw-wrap px-5 sm:px-8">
      <p class="zw-eyebrow mb-4 zw-reveal">Pricing</p>
      <h2 class="zw-h2 mb-8 max-w-[820px] zw-reveal">Build an AI knowledge asset for less than the cost of another hire.</h2>
      <p class="text-zw-muted mb-12 max-w-[640px] zw-reveal">
        Unlike a traditional retainer, the work accumulates. Every process captured becomes part
        of an asset your company keeps.
      </p>
      <OfferLadder variant="full" />
    </div>
  </section>

  <!-- ═══════ FOUNDER ═══════ -->
  <section class="zw-anchor bg-white border-y border-zw-border" style="padding-top: clamp(3rem, 6vw, 5rem); padding-bottom: clamp(3rem, 6vw, 5rem);">
    <div class="zw-wrap px-5 sm:px-8 flex flex-col sm:flex-row gap-8 items-start">
      <img src="/jack.jpg" alt="Jack Zeis" class="w-24 h-24 rounded-2xl object-cover border border-zw-border shrink-0" width="96" height="96" loading="lazy" />
      <div>
        <h2 class="zw-h3 mb-3">You won't be handed off to a junior implementation team.</h2>
        <p class="text-sm text-zw-muted leading-relaxed max-w-[640px]">
          ZeisWorks is run by Jack Zeis, a systems consultant in Golden, Colorado. He captures the
          knowledge, designs the system, and owns your engagement personally — because a business
          should own how it works, not rent it.
          <a href="/about/" class="font-medium text-zw-teal hover:underline">More about Jack →</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ═══════ CTA ═══════ -->
  <section id="start" class="zw-anchor zw-section bg-zw-forest text-zw-cream">
    <div class="zw-wrap px-5 sm:px-8"><div class="zw-measure mx-auto text-center">
      <p class="zw-eyebrow zw-eyebrow-dark mb-4 zw-reveal">Get started</p>
      <h2 class="zw-h2 mb-6 text-zw-cream zw-reveal">Your company already has an AI advantage.</h2>
      <p class="text-zw-cream/75 mb-9 zw-reveal">
        It's what your people know. Let's make it usable.
      </p>
      <AuditCta location="footer" label="See what my company knows" class="inline-flex items-center justify-center bg-zw-cream text-zw-forest font-semibold px-8 py-4 rounded-full hover:bg-white transition-colors zw-reveal" />
    </div></div>
  </section>
</LandingLayout>

<style is:global>
  /* ── Hero illustration: scattered inputs → plain files → capabilities ── */
  .zw-hero-art { display: grid; gap: 0.6rem; }
  .zw-hero-art-img {
    width: 100%;
    height: auto;
    max-width: 100%;
  }
  .zw-hero-art-caption {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 0.5rem;
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--zw-muted);
    padding-inline: 0.25rem;
  }
  .zw-hero-art-caption span:nth-child(2) { text-align: center; }
  .zw-hero-art-caption span:nth-child(3) { text-align: right; }
  html.zw-anim [data-anim="hero"] .zw-hero-art-img {
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.7s var(--zw-ease), transform 0.7s var(--zw-ease);
  }
  html.zw-anim [data-anim="hero"] .zw-hero-art-caption span {
    opacity: 0;
    transition: opacity 0.5s var(--zw-ease);
    transition-delay: calc(0.45s + var(--i, 0) * 120ms);
  }
