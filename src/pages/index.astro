---
// Homepage as a product specification. The FW-1 Free-Week Funnel is the
// product; this page is its spec sheet and installation notes.
// Proof rule unchanged: no invented names, quotes, or numbers. Anything that
// still needs Jack's sign-off carries <span class="confirm">.
import ManualLayout from '../layouts/ManualLayout.astro';
import { OFFER } from '../data/offer';
import { LIFT } from '../data/lift-stl';

const DOC = 'ZW-FW1';
const REV = '2026.09';

const toc = [
  ['1.0', 'Overview', 'overview'],
  ['2.0', 'Parts list', 'parts'],
  ['3.0', 'Specifications', 'specs'],
  ['4.0', 'Field test', 'test'],
  ['5.0', 'Compatibility', 'compat'],
  ['6.0', 'Pricing', 'pricing'],
  ['7.0', 'Warranty', 'warranty'],
  ['8.0', 'Installer', 'installer'],
  ['9.0', 'Ordering', 'order'],
];

// Assembly sequence (Fig. 1) — the six things that happen, in order.
const steps = [
  { n: 1, name: 'Ad', body: 'Meta ad to people within a few miles of the door. One offer: seven free days.' },
  { n: 2, name: 'Page', body: 'A hand-built page on the gym’s own subdomain. Four fields. Real reviews above the form.' },
  { n: 3, name: 'Text', body: 'The lead lands in the gym’s CRM and a coach calls or texts within the hour.' },
  { n: 4, name: 'Survey', body: 'Three taps after the claim: goal, training frequency, what stopped them before.' },
  { n: 5, name: 'Visit', body: 'The coach opens the door already knowing the name, the goal, and the sticking point.' },
  { n: 6, name: 'Member', body: 'Every membership traces back to the ad that started it. Cost per member, not cost per click.' },
];

// Parts list — data-part maps each row to the diagram step it belongs to.
const parts = [
  { pn: 'FW1-01', name: 'Ad set (Meta)', qty: '1', note: 'Creative, copy, radius audience, one offer', step: 1 },
  { pn: 'FW1-02', name: 'Landing page', qty: '1', note: 'Static HTML, own subdomain, four fields, loads in about a second on a phone', step: 2 },
  { pn: 'FW1-03', name: 'Review module', qty: '1', note: 'Real Google reviews with names, kept current', step: 2 },
  { pn: 'FW1-04', name: 'Tracking harness', qty: '1', note: 'Meta Pixel and GA4 fire on the claim and the survey, not just the page view', step: 2 },
  { pn: 'FW1-05', name: 'Lead routing', qty: '1', note: 'Into the CRM the gym already runs, survey answers attached', step: 3 },
  { pn: 'FW1-06', name: 'First-hour script', qty: '1', note: 'What the coach sends within sixty minutes, and what to say on the call', step: 3 },
  { pn: 'FW1-07', name: 'Post-claim survey', qty: '1', note: 'Goal, frequency, sticking point, contact preference. Optional for the lead', step: 4 },
  { pn: 'FW1-08', name: 'Monthly read', qty: '12 / yr', note: 'One page: leads, shows, members, cost per member', step: 6 },
];

const specs = [
  ['Offer', '7 days free', 'No card required to claim. Card on file at the visit, not charged during the week.'],
  ['Form fields', '4', 'First name, last name, email, phone. Eligibility stated on the form.'],
  ['Response target', '≤ 60 min', 'A human. Call or text.'],
  ['Hosting', 'Static, own subdomain', 'No page builder, no platform fee, nothing that breaks when a vendor changes plans.'],
  ['Tracking', 'Meta Pixel + GA4', 'Events on submit, so ad spend ties to actual claims.'],
  ['Lead time', 'About 14 days', 'The slow part is photos and approvals, not the build.'],
  ['Ownership', 'The gym', 'Page, subdomain, ad account, pixel, and every lead.'],
  ['Contract', 'None', 'Month to month. Cancel any month.'],
  ['Dependencies', '1 coach with a phone', 'See caution below.'],
];

const compatible = [
  'Independent strength gyms, 24/7 gyms, personal training studios',
  'One or two locations, owner on the floor most days',
  'Month-to-month memberships and a free week the owner would actually offer',
  'Good reviews that nobody has put to work',
];
const incompatible = [
  'Franchises and brand campaigns',
  'Gyms where no coach can reply within the hour',
  'Owners who want a chatbot instead of a person',
];

const skus = [
  { sku: 'FW-0', item: OFFER.teardown.name, price: OFFER.teardown.price, terms: OFFER.teardown.terms, body: OFFER.teardown.body },
  { sku: 'FW-1', item: OFFER.build.name, price: OFFER.build.price, terms: OFFER.build.terms, body: OFFER.build.body },
  { sku: 'FW-1R', item: OFFER.run.name, price: OFFER.run.price, terms: OFFER.run.terms, body: OFFER.run.body },
];
---

<ManualLayout
  title="FW-1 Free-Week Funnel · ZeisWorks"
  description="Product specification for the FW-1 Free-Week Funnel: a six-part assembly that moves a person from an Instagram ad to a gym membership. Installed by ZeisWorks. Field tested at Lift-STL, Brentwood, Missouri."
  docNumber={DOC}
  revision={REV}
>
  <div class="m-grid">
    <!-- ── Contents rail ── -->
    <nav class="m-rail" aria-label="Contents">
      <p class="m-label mb-2">Contents</p>
      <ol>
        {toc.map(([n, label, id]) => <li><a href={`#${id}`}><span>{n}</span><span>{label}</span></a></li>)}
      </ol>
      <a href="/start/" data-audit-cta data-cta-location="rail" class="m-btn mt-6 w-full">Request inspection</a>
      <p class="m-mono mt-3" style="color: var(--ink-2); font-size: 0.7rem;">Free. 15 minutes.</p>
    </nav>

    <div>
      <!-- ── Title block ── -->
      <section class="pt-10 pb-8" aria-label="Title">
        <p class="m-label mb-4">Product specification and installation notes</p>
        <div class="flex flex-wrap items-start justify-between gap-6">
          <h1 class="m-title" style="max-width: 12ch;">FW-1 Free-Week Funnel</h1>
          <span class="stamp mt-3">Field tested · Lift-STL</span>
        </div>
        <p class="m-lede mt-7 mb-8">
          A six-part assembly that moves a person from an Instagram ad to a membership agreement at an
          independent gym. Installed on the gym’s own subdomain, wired to the gym’s own ad account,
          owned outright by the gym.
        </p>
        <div class="m-scroll">
          <table class="m-table" style="max-width: 62ch;">
            <tbody>
              <tr><td class="pn">Intended use</td><td>Independent strength gyms, 24/7 gyms, personal training studios</td></tr>
              <tr><td class="pn">Not intended for</td><td>Franchises, big-box clubs, anyone without a coach on the floor</td></tr>
              <tr><td class="pn">Field test</td><td>{LIFT.name}, {LIFT.city}, 2026 · <a href={LIFT.funnelUrl} target="_blank" rel="noopener">join.lift-stl.com ↗</a></td></tr>
              <tr><td class="pn">Installer</td><td>Jack Zeis, Golden, Colorado</td></tr>
              <tr><td class="pn">Lead time</td><td>About 14 days</td></tr>
            </tbody>
          </table>
        </div>
        <div class="flex flex-wrap gap-3 mt-8">
          <a href="/start/" data-audit-cta data-cta-location="hero" class="m-btn">Request a free inspection</a>
          <a href="#test" class="m-btn m-btn-outline">Read the field test</a>
        </div>
      </section>

      <!-- ── 1.0 Overview + Fig. 1 ── -->
      <section id="overview" class="m-section">
        <div class="m-section-head"><span class="num">1.0</span><h2 class="m-h">Overview</h2></div>
        <p class="m-body mb-8">
          Most gyms already own a free trial. It is usually a form on a template site that emails somebody. The FW-1
          replaces the whole path between the ad and the handshake with six parts that each make the next one easier,
          and it measures every one of them. The last measurement is the only one that matters: what a member costs.
        </p>

        <figure class="m-fig">
          <div class="diagram" aria-describedby="fig1-cap">
            <svg viewBox="0 0 1000 640" role="img" aria-labelledby="fig1-title" xmlns="http://www.w3.org/2000/svg">
              <title id="fig1-title">Exploded view of the FW-1: ad, page, text, survey, visit, member, connected in sequence.</title>
              <defs>
                <marker id="arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="#141414"/></marker>
              </defs>
              <!-- assembly axis -->
              <line x1="60" y1="60" x2="960" y2="560" class="axis" />
              <!-- connectors -->
              <g class="conn">
                <path d="M215 118 C 260 118, 262 150, 296 172" />
                <path d="M404 330 C 430 360, 445 372, 486 372" />
                <path d="M640 342 C 668 328, 690 300, 718 292" />
                <path d="M804 268 C 815 300, 815 330, 815 372" />
                <path d="M786 486 C 786 520, 800 552, 838 552" />
              </g>

              <!-- 1 AD -->
              <g class="part" data-part="1">
                <rect x="60" y="60" width="155" height="118" rx="4" />
                <rect x="72" y="72" width="131" height="52" />
                <path d="M72 124 L110 92 L140 116 L160 100 L203 124 Z" class="fill-ink" />
                <line x1="72" y1="136" x2="180" y2="136" /><line x1="72" y1="146" x2="150" y2="146" />
                <rect x="72" y="156" width="52" height="12" rx="2" class="fill-red" />
                <text x="60" y="52" class="lbl">AD</text>
              </g>
              <!-- 2 PAGE -->
              <g class="part" data-part="2">
                <rect x="296" y="118" width="108" height="212" rx="14" />
                <rect x="304" y="130" width="92" height="188" rx="8" />
                <rect x="340" y="124" width="20" height="4" rx="2" class="fill-ink" />
                <line x1="316" y1="150" x2="380" y2="150" style="stroke-width:3" /><line x1="316" y1="160" x2="366" y2="160" style="stroke-width:3" />
                <line x1="316" y1="176" x2="384" y2="176" /><line x1="316" y1="184" x2="372" y2="184" />
                <g class="fill-red"><path d="M320 200l2.5 5 5.5.8-4 3.9.9 5.5-4.9-2.6-4.9 2.6.9-5.5-4-3.9 5.5-.8z"/><path d="M336 200l2.5 5 5.5.8-4 3.9.9 5.5-4.9-2.6-4.9 2.6.9-5.5-4-3.9 5.5-.8z"/><path d="M352 200l2.5 5 5.5.8-4 3.9.9 5.5-4.9-2.6-4.9 2.6.9-5.5-4-3.9 5.5-.8z"/><path d="M368 200l2.5 5 5.5.8-4 3.9.9 5.5-4.9-2.6-4.9 2.6.9-5.5-4-3.9 5.5-.8z"/></g>
                <rect x="316" y="226" width="68" height="14" rx="2" /><rect x="316" y="246" width="68" height="14" rx="2" /><rect x="316" y="266" width="68" height="14" rx="2" /><rect x="316" y="286" width="68" height="14" rx="2" />
                <rect x="316" y="306" width="68" height="8" rx="2" class="fill-red" />
                <text x="296" y="110" class="lbl">PAGE</text>
              </g>
              <!-- 3 TEXT -->
              <g class="part" data-part="3">
                <path d="M486 330 h150 a8 8 0 0 1 8 8 v58 a8 8 0 0 1 -8 8 h-112 l-22 18 v-18 h-16 a8 8 0 0 1 -8 -8 v-58 a8 8 0 0 1 8 -8z" />
                <line x1="500" y1="350" x2="612" y2="350" /><line x1="500" y1="362" x2="596" y2="362" /><line x1="500" y1="374" x2="560" y2="374" />
                <circle cx="612" cy="386" r="9" /><line x1="612" y1="380" x2="612" y2="386" /><line x1="612" y1="386" x2="617" y2="389" />
                <text x="478" y="320" class="lbl">TEXT · ≤ 60 MIN</text>
              </g>
              <!-- 4 SURVEY -->
              <g class="part" data-part="4">
                <rect x="718" y="176" width="150" height="116" rx="4" />
                <g>
                  <rect x="732" y="192" width="28" height="14" rx="7" /><circle cx="753" cy="199" r="5" class="fill-ink" /><line x1="770" y1="199" x2="850" y2="199" />
                  <rect x="732" y="220" width="28" height="14" rx="7" /><circle cx="739" cy="227" r="5" /><line x1="770" y1="227" x2="836" y2="227" />
                  <rect x="732" y="248" width="28" height="14" rx="7" /><circle cx="753" cy="255" r="5" class="fill-ink" /><line x1="770" y1="255" x2="844" y2="255" />
                </g>
                <text x="718" y="168" class="lbl">SURVEY</text>
              </g>
              <!-- 5 VISIT -->
              <g class="part" data-part="5">
                <rect x="742" y="372" width="88" height="114" rx="2" />
                <rect x="752" y="382" width="68" height="104" />
                <circle cx="808" cy="440" r="4" class="fill-ink" />
                <path d="M752 486 L752 372" />
                <text x="742" y="364" class="lbl">VISIT</text>
              </g>
              <!-- 6 MEMBER -->
              <g class="part" data-part="6">
                <rect x="838" y="504" width="130" height="86" rx="6" />
                <rect x="850" y="516" width="32" height="24" rx="3" />
                <line x1="892" y1="522" x2="952" y2="522" /><line x1="892" y1="532" x2="936" y2="532" />
                <line x1="850" y1="556" x2="952" y2="556" /><line x1="850" y1="568" x2="920" y2="568" />
                <path d="M944 566l2.5 5 5.5.8-4 3.9.9 5.5-4.9-2.6-4.9 2.6.9-5.5-4-3.9 5.5-.8z" class="fill-red" />
                <text x="838" y="496" class="lbl">MEMBER</text>
              </g>

              <!-- callouts -->
              <g class="callouts">
                <g data-part="1" class="co"><line x1="140" y1="200" x2="140" y2="178" /><circle cx="140" cy="214" r="13" /><text x="140" y="219">1</text></g>
                <g data-part="2" class="co"><line x1="350" y1="352" x2="350" y2="330" /><circle cx="350" cy="366" r="13" /><text x="350" y="371">2</text></g>
                <g data-part="3" class="co"><line x1="560" y1="424" x2="560" y2="404" /><circle cx="560" cy="438" r="13" /><text x="560" y="443">3</text></g>
                <g data-part="4" class="co"><line x1="793" y1="140" x2="793" y2="176" /><circle cx="793" cy="126" r="13" /><text x="793" y="131">4</text></g>
                <g data-part="5" class="co"><line x1="700" y1="430" x2="742" y2="430" /><circle cx="686" cy="430" r="13" /><text x="686" y="435">5</text></g>
                <g data-part="6" class="co"><line x1="903" y1="612" x2="903" y2="590" /><circle cx="903" cy="626" r="13" /><text x="903" y="631">6</text></g>
              </g>

              <!-- dimension: lead time -->
              <g class="dim">
                <line x1="60" y1="608" x2="640" y2="608" marker-start="url(#arr)" marker-end="url(#arr)" />
                <line x1="60" y1="598" x2="60" y2="618" /><line x1="640" y1="598" x2="640" y2="618" />
                <rect x="290" y="596" width="120" height="22" class="fill-paper" />
                <text x="350" y="612">≈ 14 DAYS TO INSTALL</text>
              </g>
              <text x="60" y="34" class="lbl">FIG. 1 · EXPLODED VIEW · SCALE: NONE</text>
            </svg>
          </div>
          <figcaption id="fig1-cap"><b>Fig. 1</b> Assembly sequence. Hover a callout, or a row in the parts list, to locate the part.</figcaption>
        </figure>

        <ol class="steps mt-8">
          {steps.map((s) => (
            <li data-part={s.n}>
              <span class="co-num">{s.n}</span>
              <div><p class="m-sub">{s.name}</p><p class="m-muted m-0 text-[0.92rem]">{s.body}</p></div>
            </li>
          ))}
        </ol>
      </section>

      <!-- ── 2.0 Parts list ── -->
      <section id="parts" class="m-section">
        <div class="m-section-head"><span class="num">2.0</span><h2 class="m-h">Parts list</h2></div>
        <div class="m-scroll">
          <table class="m-table m-table-wide">
            <thead><tr><th>Part no.</th><th>Part</th><th class="qty">Qty</th><th>Notes</th></tr></thead>
            <tbody>
              {parts.map((p) => (
                <tr data-part={p.step}>
                  <td class="pn">{p.pn}</td>
                  <td style="font-weight: 500;">{p.name}</td>
                  <td class="qty">{p.qty}</td>
                  <td class="m-muted">{p.note}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="m-note mt-6"><span class="k">Note</span><span>All parts ship with source. No proprietary fasteners. If ZeisWorks disappears, nothing in this list stops working.</span></div>
      </section>

      <!-- ── 3.0 Specifications ── -->
      <section id="specs" class="m-section">
        <div class="m-section-head"><span class="num">3.0</span><h2 class="m-h">Specifications</h2></div>
        <div class="m-scroll">
          <table class="m-table m-table-wide">
            <thead><tr><th>Property</th><th>Value</th><th>Notes</th></tr></thead>
            <tbody>
              {specs.map(([k, v, n]) => (
                <tr><td class="m-muted" style="width: 11rem;">{k}</td><td style="font-weight: 500; white-space: nowrap;">{v}</td><td class="m-muted">{n}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="m-caution mt-6">
          <span class="k">Caution</span>
          <span>Do not install without a coach. The FW-1 converts only when a human replies within the hour. A form that emails nobody is not a funnel. It is a leak.</span>
        </div>
      </section>

      <!-- ── 4.0 Field test ── -->
      <section id="test" class="m-section">
        <div class="m-section-head"><span class="num">4.0</span><h2 class="m-h">Field test: {LIFT.name}, {LIFT.city}</h2></div>
        <p class="m-body mb-6">
          {LIFT.owner} opened {LIFT.name} in {LIFT.founded} with an SBA loan and a plan. By 2026 the gym held a {LIFT.rating}-star Google
          rating on {LIFT.reviewCount} reviews and a website that was a template. The free pass was a form that emailed someone.
          The FW-1 was installed on join.lift-stl.com and is live at the time of this revision.
        </p>
        <div class="grid md:grid-cols-[1.6fr_1fr] gap-5 items-start">
          <figure class="m-fig">
            <img src="/media/lift-desktop-hero.webp" alt="The Lift-STL free 7-day pass page on a desktop browser." width="1600" height="1000" loading="lazy" />
            <figcaption><b>Fig. 2</b> FW1-02 as installed, desktop. Screenshot of the live page, September 2026. Not a mockup.</figcaption>
          </figure>
          <figure class="m-fig">
            <img src="/media/lift-mobile-hero.webp" alt="The Lift-STL page on a phone, above the fold." width="780" height="1688" loading="lazy" style="aspect-ratio: 9 / 13; object-fit: cover; object-position: top;" />
            <figcaption><b>Fig. 3</b> Same page, phone. The claim button sits above the fold and again in a sticky bar.</figcaption>
          </figure>
        </div>
        <div class="grid md:grid-cols-2 gap-8 mt-8">
          <div class="m-scroll">
            <p class="m-label mb-2">Observed on the live page</p>
            <table class="m-table">
              <tbody>
                <tr><td class="m-muted">Offer</td><td style="font-weight:500;">7 days, no card</td></tr>
                <tr><td class="m-muted">Rating shown</td><td style="font-weight:500;">{LIFT.rating} ★ on {LIFT.reviewCount} Google reviews</td></tr>
                <tr><td class="m-muted">Response promise</td><td style="font-weight:500;">Coach calls or texts within the hour</td></tr>
                <tr><td class="m-muted">Tracking</td><td style="font-weight:500;">Meta Pixel + GA4 on claim and survey</td></tr>
                <tr><td class="m-muted">Lead routing</td><td style="font-weight:500;">Wix Contacts, survey answers attached</td></tr>
              </tbody>
            </table>
          </div>
          <div class="m-scroll">
            <p class="m-label mb-2">Results · pending certification</p>
            <table class="m-table">
              <tbody>
                <tr><td class="m-muted">Leads</td><td><span class="confirm">confirm</span></td></tr>
                <tr><td class="m-muted">Show rate</td><td><span class="confirm">confirm</span></td></tr>
                <tr><td class="m-muted">Members</td><td><span class="confirm">confirm</span></td></tr>
                <tr><td class="m-muted">Cost per member</td><td><span class="confirm">confirm</span></td></tr>
              </tbody>
            </table>
            <p class="pen mt-3">Numbers appear here only once Jack can defend them on a call. Nothing on this sheet is invented.</p>
          </div>
        </div>
        <p class="mt-6"><a href="/lift-stl/" class="m-btn m-btn-outline">Full test report</a></p>
      </section>

      <!-- ── 5.0 Compatibility ── -->
      <section id="compat" class="m-section">
        <div class="m-section-head"><span class="num">5.0</span><h2 class="m-h">Compatibility</h2></div>
        <div class="grid md:grid-cols-2 gap-8">
          <div>
            <p class="m-label mb-3">Compatible</p>
            <ul class="tick">{compatible.map((x) => <li>{x}</li>)}</ul>
          </div>
          <div>
            <p class="m-label mb-3">Not compatible</p>
            <ul class="cross">{incompatible.map((x) => <li>{x}</li>)}</ul>
          </div>
        </div>
        <figure class="m-fig mt-8">
          <img src="/media/fig-desk.webp" alt="A coach greeting a first-time visitor at a gym front desk." width="1400" height="933" loading="lazy" />
          <figcaption><b>Fig. 4</b> Step 5, the visit. Illustration. The coach already knows the goal because the survey asked.</figcaption>
        </figure>
      </section>

      <!-- ── 6.0 Pricing ── -->
      <section id="pricing" class="m-section">
        <div class="m-section-head"><span class="num">6.0</span><h2 class="m-h">Pricing</h2></div>
        <div class="m-scroll">
          <table class="m-table m-table-wide">
            <thead><tr><th>SKU</th><th>Item</th><th>Price</th><th>Terms</th></tr></thead>
            <tbody>
              {skus.map((s) => (
                <tr>
                  <td class="pn">{s.sku}</td>
                  <td><span style="font-weight: 500;">{s.item}</span><br /><span class="m-muted text-[0.88rem]">{s.body}</span></td>
                  <td style="white-space: nowrap; font-weight: 500;">{s.price ?? <span class="confirm">confirm</span>}</td>
                  <td class="m-muted" style="white-space: nowrap;">{s.terms}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="m-note mt-6"><span class="k">Note</span><span>Each SKU is optional until you have seen the one before it. FW-0 is free and ends with a straight answer about fit.</span></div>
      </section>

      <!-- ── 7.0 Warranty ── -->
      <section id="warranty" class="m-section">
        <div class="m-section-head"><span class="num">7.0</span><h2 class="m-h">Warranty</h2></div>
        <div class="grid md:grid-cols-[1fr_1fr] gap-8 items-start">
          <p class="m-body m-0" style="font-size: 1.05rem;">
            If the FW-1 stops producing members, stop paying. Everything stays installed. There is no contract to exit,
            because there is no contract. The page, the subdomain, the ad account, the pixel, and every lead remain the gym’s
            property from the day they are built.
          </p>
