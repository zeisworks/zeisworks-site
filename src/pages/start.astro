---
import FunnelLayout from '../layouts/FunnelLayout.astro';
import Logo from '../components/Logo.astro';
import { CALENDLY_URL } from '../config';

// ── Perspective-style interactive funnel ──
// Mobile-first, one-question-per-screen, tap-to-advance. Progressive
// disclosure: four no-PII qualifying taps, then capture (Netlify Forms), then
// a book step. Every answer is carried into hidden form fields so the lead
// arrives fully qualified.
const steps = [
  {
    key: 'segment',
    q: 'What kind of gym do you run?',
    options: ['Strength or 24/7 gym', 'Personal training studio', 'CrossFit, boxing, or martial arts', 'Something else'],
  },
  {
    key: 'knowledge',
    q: 'What happens today when someone asks about a trial?',
    options: ['A form emails someone', 'They DM us on Instagram', 'They walk in or call', "We don't really offer one"],
  },
  {
    key: 'risk',
    q: 'How fast does a new lead hear back from a coach?',
    options: ['Within the hour', 'Same day, usually', 'A day or two', 'Honestly, not sure'],
  },
  {
    key: 'team',
    q: 'Roughly how many members do you have?',
    options: ['Under 100', '100–300', '300–800', '800+'],
  },
];
---

<FunnelLayout
  title="Get your free-week plan · ZeisWorks"
  description="Four quick questions about your gym. A free-week plan back: the offer, the page, the follow-up, and what a member should cost you. Free, no obligation."
  ogImage="/og.png"
>
  <main class="funnel" data-funnel>
    <!-- Top bar: brand · progress · back -->
    <header class="funnel-top">
      <a href="/" class="funnel-brand" aria-label="ZeisWorks home">
        <Logo class="funnel-logo" />
        <span class="funnel-name">zeisWorks<span class="dot">.</span></span>
      </a>
      <div class="funnel-progress" aria-hidden="true"><span class="funnel-progress-bar" data-progress></span></div>
      <button type="button" class="funnel-back" data-back hidden aria-label="Previous question">&larr;</button>
    </header>

    <div class="funnel-stage">
      <!-- Qualifying questions -->
      {steps.map((step, i) => (
        <section class="screen" data-screen={i} role="group" aria-label={step.q} hidden={i !== 0}>
          <p class="screen-kicker zw-mono">Question {i + 1} of {steps.length}</p>
          <h1 class="screen-q">{step.q}</h1>
          <div class="screen-options">
            {step.options.map((opt) => (
              <button type="button" class="option" data-key={step.key} data-value={opt}>
                <span>{opt}</span>
                <span class="option-arrow" aria-hidden="true">&rarr;</span>
              </button>
            ))}
          </div>
        </section>
      ))}

      <!-- Capture -->
      <section class="screen" data-screen={steps.length} role="group" aria-label="Where should we send your free-week plan?" hidden>
        <p class="screen-kicker zw-mono">Almost there</p>
        <h1 class="screen-q">Where should we send your free-week plan?</h1>
        <p class="screen-summary" data-summary></p>
        <form
          class="capture-form"
          name="vik-intake"
          method="POST"
          action="/start/"
          data-netlify="true"
          netlify-honeypot="bot-field"
          data-capture-form
        >
          <input type="hidden" name="form-name" value="vik-intake" />
          <p class="hp" aria-hidden="true">
            <label>Don't fill this out if you're human: <input name="bot-field" tabindex="-1" /></label>
          </p>
          <!-- Qualifying answers, filled in by JS before submit -->
          <input type="hidden" name="segment" data-answer="segment" />
          <input type="hidden" name="knowledge" data-answer="knowledge" />
          <input type="hidden" name="risk" data-answer="risk" />
          <input type="hidden" name="team" data-answer="team" />
          <!-- Attribution, filled in by JS on load -->
          <input type="hidden" name="utm_source" data-utm="utm_source" />
          <input type="hidden" name="utm_medium" data-utm="utm_medium" />
          <input type="hidden" name="utm_campaign" data-utm="utm_campaign" />
          <input type="hidden" name="utm_content" data-utm="utm_content" />
          <input type="hidden" name="referrer" data-utm="referrer" />
          <input type="hidden" name="landing_path" data-utm="landing_path" />

          <label class="field">
            <span class="field-label">Your name</span>
            <input type="text" name="name" autocomplete="name" placeholder="Jane Doe" required />
          </label>
          <label class="field">
            <span class="field-label">Email</span>
            <input type="email" name="email" autocomplete="email" placeholder="you@company.com" required />
          </label>
          <label class="field">
            <span class="field-label">Phone <span class="field-opt">(optional)</span></span>
            <input type="tel" name="phone" autocomplete="tel" placeholder="(555) 555-5555" />
          </label>
          <button type="submit" class="cta cta-block" data-submit>Send my free-week plan</button>
          <p class="fineprint">Free. No obligation. We'll never share your details.</p>
        </form>
      </section>

      <!-- Book -->
      <section class="screen screen-center" data-screen={steps.length + 1} role="group" aria-label="Book a call" hidden>
        <div class="mark-ok" aria-hidden="true">✓</div>
        <h1 class="screen-q">You're in. Want to talk it through?</h1>
        <p class="screen-sub">Your plan is on its way. The fastest next step is a free 15-minute teardown of your current trial offer.</p>
        <a href={CALENDLY_URL} class="cta cta-block" data-book>Book the free teardown</a>
        <button type="button" class="cta-text" data-done>No thanks, I'll wait for the email</button>
      </section>

      <!-- Confirmation -->
      <section class="screen screen-center" data-screen={steps.length + 2} role="group" aria-label="All set" hidden>
        <div class="mark-ok" aria-hidden="true">✓</div>
        <h1 class="screen-q">You're all set.</h1>
        <p class="screen-sub">Check your inbox — your free-week plan is on its way. We'll be in touch shortly.</p>
        <a href="/" class="cta-text">Back to zeisworks.com</a>
      </section>
    </div>
  </main>

  <script is:inline define:vars={{ stepKeys: steps.map((s) => s.key), totalQuestions: steps.length, calendlyUrl: CALENDLY_URL }}>
    (function () {
      var root = document.querySelector('[data-funnel]');
      if (!root) return;
      var screens = Array.prototype.slice.call(root.querySelectorAll('.screen'));
      var progress = root.querySelector('[data-progress]');
      var backBtn = root.querySelector('[data-back]');
      var summaryEl = root.querySelector('[data-summary]');
      var form = root.querySelector('[data-capture-form]');
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      var CAPTURE = totalQuestions;          // index of the capture screen
      var BOOK = totalQuestions + 1;
      var DONE = totalQuestions + 2;
      var answers = {};
      var contact = {};
      var attribution = {};
      var idx = 0;

      function track(event, params) {
        try { if (typeof gtag === 'function') gtag('event', event, params || {}); } catch (e) {}
        try { if (typeof fbq === 'function') fbq('trackCustom', event, params || {}); } catch (e) {}
      }

      function setProgress() {
        // Progress runs across the qualifying questions + capture.
        var pct = Math.min(idx, CAPTURE) / CAPTURE * 100;
        if (idx > CAPTURE) pct = 100;
        if (progress) progress.style.width = pct + '%';
      }

      function show(next, dir) {
        var prev = screens[idx];
        idx = next;
        screens.forEach(function (s, i) {
          var on = i === idx;
          s.hidden = !on;
          if (on && !reduce) {
            s.classList.remove('slide-in');
            // force reflow so the animation replays
            void s.offsetWidth;
            s.classList.add('slide-in');
          }
        });
        if (backBtn) backBtn.hidden = idx === 0 || idx >= BOOK;
        setProgress();
        // Move focus to the first actionable element on the new screen.
        var focusTarget = screens[idx].querySelector('.option, input, .cta, .cta-text');
        if (focusTarget) { try { focusTarget.focus({ preventScroll: true }); } catch (e) {} }
        if (idx === CAPTURE) buildSummary();
        if (idx < totalQuestions) track('funnel_step', { step: idx + 1, key: stepKeys[idx] });
      }

      function buildSummary() {
        if (!summaryEl) return;
        var k = (answers.knowledge || '').toLowerCase();
        var r = (answers.risk || '').toLowerCase();
        var parts = [];
        if (k) parts.push('your know-how lives ' + k);
        if (r && r.indexOf('fine') === -1 && r.indexOf('not sure') === -1) parts.push('and ' + r + ' when a key person is out');
        var lead = "Here's where your free week would start.";
        summaryEl.textContent = lead;
      }

      // ── Option taps: store answer, auto-advance ──
      root.querySelectorAll('.option').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var key = btn.getAttribute('data-key');
          var val = btn.getAttribute('data-value');
          answers[key] = val;
          var hidden = form ? form.querySelector('[data-answer="' + key + '"]') : null;
          if (hidden) hidden.value = val;
          // brief selected state, then advance
          btn.classList.add('is-selected');
          setTimeout(function () { btn.classList.remove('is-selected'); show(idx + 1, 1); }, 160);
        });
      });

      if (backBtn) backBtn.addEventListener('click', function () { if (idx > 0) show(idx - 1, -1); });

      // ── Capture submit → Netlify Forms, then the book step ──
      if (form) {
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          var btn = form.querySelector('[data-submit]');
          if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }
          var fd = new FormData(form);
          contact.name = (fd.get('name') || '').toString();
          contact.email = (fd.get('email') || '').toString();
          setBookHref();
          var body = new URLSearchParams(fd).toString();
          track('lead_submit', {});
          fetch(form.getAttribute('action'), {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: body,
          })
            .then(function () { show(BOOK, 1); })
            .catch(function () { form.submit(); }); // never drop a lead
        });
      }

      var bookBtn = root.querySelector('[data-book]');
      if (bookBtn) bookBtn.addEventListener('click', function () { track('book_click', {}); });
      var doneBtn = root.querySelector('[data-done]');
      if (doneBtn) doneBtn.addEventListener('click', function () { show(DONE, 1); });

      // Keyboard: number keys pick an option on question screens.
      document.addEventListener('keydown', function (e) {
        if (idx >= totalQuestions) return;
        var n = parseInt(e.key, 10);
        if (!n) return;
        var opts = screens[idx].querySelectorAll('.option');
        if (opts[n - 1]) opts[n - 1].click();
      });

      // ── Booking link: prefill name/email on a real scheduler, or pre-write
      //    the email on the mailto fallback, from the answers we already have. ──
      function buildBookHref(base) {
        try {
          if (/^https?:/i.test(base)) {
            var u = new URL(base);
            if (contact.name) u.searchParams.set('name', contact.name);
            if (contact.email) u.searchParams.set('email', contact.email);
            if (answers.segment) u.searchParams.set('segment', answers.segment);
            ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content'].forEach(function (k) {
              if (attribution[k]) u.searchParams.set(k, attribution[k]);
            });
            return u.href;
          }
          if (/^mailto:/i.test(base)) {
            var addr = base.replace(/^mailto:/i, '').split('?')[0];
            var subject = 'Free-week plan for my gym' + (contact.name ? ' — ' + contact.name : '');
            var lines = ['Hi Jack,', '', "I'd like to book the free trial teardown.", ''];
            if (answers.segment) lines.push('Gym type: ' + answers.segment);
            if (answers.knowledge) lines.push('Trial today: ' + answers.knowledge);
            if (answers.risk) lines.push('Lead response: ' + answers.risk);
            if (answers.team) lines.push('Members: ' + answers.team);
            if (contact.name) { lines.push(''); lines.push('— ' + contact.name); }
            return 'mailto:' + addr + '?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(lines.join('\n'));
          }
        } catch (e) {}
        return base;
      }
      function setBookHref() {
        var btn = root.querySelector('[data-book]');
        if (btn) btn.setAttribute('href', buildBookHref(calendlyUrl));
      }

      // ── Attribution: carry UTM + referrer into the lead (and the booking). ──
      (function initAttribution() {
        var params = new URLSearchParams(window.location.search);
        var stored = {};
        try { stored = JSON.parse(sessionStorage.getItem('zw_utm') || '{}'); } catch (e) {}
        ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content'].forEach(function (k) {
          var v = params.get(k) || stored[k] || '';
          if (v) attribution[k] = v;
        });
        attribution.referrer = document.referrer || '';
        attribution.landing_path = window.location.pathname + window.location.search;
        if (form) {
          form.querySelectorAll('[data-utm]').forEach(function (input) {
            var k = input.getAttribute('data-utm');
            if (attribution[k]) input.value = attribution[k];
          });
        }
      })();

      // ── Segment pages pre-answer Q1 via ?segment=…; the funnel starts at
      //    Q2 and the back button still returns to Q1 to override. ──
      (function initSegment() {
        var map = {
          consulting: 'Consulting or advisory',
          agency: 'Agency or studio',
          other: 'Other professional services (legal, accounting, finance)',
        };
        var seg = new URLSearchParams(window.location.search).get('segment');
        var val = seg && map[seg.toLowerCase()];
        if (!val) return;
        answers.segment = val;
        var hidden = form ? form.querySelector('[data-answer="segment"]') : null;
        if (hidden) hidden.value = val;
        show(1);
      })();

      track('funnel_start', {});
      setProgress();
    })();
  </script>

  <style>
    .funnel {
      min-height: 100svh;
      display: flex;
      flex-direction: column;
      color: #fff;
      font-family: 'DM Sans', system-ui, sans-serif;
      background:
        radial-gradient(120% 80% at 88% 0%, rgba(224, 69, 48, 0.30), transparent 58%),
        linear-gradient(158deg, #1d1d1f 0%, #141416 55%, #000000 100%);
      background-attachment: fixed;
    }
    .zw-mono { font-family: 'DM Mono', ui-monospace, monospace; }

    /* ── Top bar ── */
    .funnel-top {
      position: relative;
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 18px clamp(18px, 5vw, 40px);
    }
    .funnel-brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; color: #fff; }
    :global(.funnel-logo) { width: 30px; height: 30px; border-radius: 7px; }
    .funnel-name { font-family: 'Space Grotesk', 'DM Sans', system-ui, sans-serif; font-weight: 600; font-size: 1.1rem; }
    .funnel-name .dot { color: #F0A184; }
    .funnel-progress {
      flex: 1;
      height: 4px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.14);
      overflow: hidden;
    }
    .funnel-progress-bar {
      display: block;
      height: 100%;
      width: 0%;
      border-radius: 999px;
      background: linear-gradient(90deg, #F0A184, #C2410C);
      transition: width 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .funnel-back {
      flex: none;
      width: 38px; height: 38px;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.28);
      background: rgba(255, 255, 255, 0.06);
      color: #fff; font-size: 1.1rem; line-height: 1; cursor: pointer;
      transition: background 0.15s;
    }
    .funnel-back:hover { background: rgba(255, 255, 255, 0.16); }

    /* ── Stage ── */
    .funnel-stage {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 12px clamp(18px, 5vw, 40px) clamp(32px, 8vh, 72px);
    }
    .screen { width: 100%; max-width: 540px; }
    .screen[hidden] { display: none; }
    .screen-center { text-align: center; }
    .screen-kicker {
      font-size: 0.72rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: #F0A184;
      margin: 0 0 14px;
    }
    .screen-q {
      font-family: 'Space Grotesk', 'DM Sans', system-ui, sans-serif;
      font-weight: 600;
      font-size: clamp(1.7rem, 4.6vw, 2.5rem);
      line-height: 1.12;
      letter-spacing: -0.01em;
      margin: 0 0 24px;
      text-wrap: balance;
    }
    .screen-summary {
      font-size: 1.02rem;
      line-height: 1.55;
      color: rgba(255, 255, 255, 0.82);
      margin: -8px 0 22px;
    }
    .screen-sub {
      font-size: 1.02rem;
      line-height: 1.6;
      color: rgba(255, 255, 255, 0.82);
      max-width: 42ch;
      margin: 0 auto 26px;
    }

    /* ── Options ── */
    .screen-options { display: flex; flex-direction: column; gap: 12px; }
    .option {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      width: 100%;
      text-align: left;
      font: inherit;
      font-size: 1.05rem;
      font-weight: 500;
      color: #fff;
      padding: 18px 20px;
      border-radius: 14px;
      border: 1px solid rgba(255, 255, 255, 0.18);
      background: rgba(255, 255, 255, 0.06);
      cursor: pointer;
      transition: border-color 0.15s, background 0.15s, transform 0.12s;
    }
    .option:hover { border-color: rgba(240, 161, 132, 0.8); background: rgba(255, 255, 255, 0.1); }
    .option:focus-visible { outline: 2px solid #F0A184; outline-offset: 2px; }
    .option.is-selected { background: rgba(224, 69, 48, 0.9); border-color: #C2410C; transform: scale(0.99); }
    .option-arrow { color: #F0A184; opacity: 0; transition: opacity 0.15s, transform 0.15s; }
    .option:hover .option-arrow { opacity: 1; transform: translateX(2px); }

    /* ── Capture form ── */
    .capture-form { display: flex; flex-direction: column; gap: 14px; }
    .field { display: flex; flex-direction: column; gap: 6px; }
    .field-label { font-size: 0.85rem; font-weight: 500; color: rgba(255, 255, 255, 0.78); }
    .field-opt { color: rgba(255, 255, 255, 0.45); font-weight: 400; }
    .field input {
      font: inherit; font-size: 1rem;
      color: #1D1D1F;
      background: #fff;
      border: 1px solid transparent;
      border-radius: 11px;
      padding: 13px 15px;
      outline: none;
      transition: box-shadow 0.15s;
    }
    .field input:focus { box-shadow: 0 0 0 3px rgba(240, 161, 132, 0.55); }
    .hp { position: absolute; left: -9999px; opacity: 0; }
    .fineprint { font-size: 0.8rem; color: rgba(255, 255, 255, 0.5); margin: 4px 0 0; text-align: center; }

    /* ── CTAs ── */
    .cta {
      display: inline-flex; align-items: center; justify-content: center;
      font: inherit; font-size: 1.05rem; font-weight: 600;
      color: #fff; background: #E04530;
      border: none; border-radius: 999px;
      padding: 15px 30px; cursor: pointer; text-decoration: none;
      transition: background 0.18s, transform 0.18s;
    }
    .cta:hover { background: #C2410C; transform: translateY(-1px); }
    .cta:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
    .cta-block { width: 100%; margin-top: 6px; }
    .cta:disabled { opacity: 0.6; cursor: default; transform: none; }
    .cta-text {
      display: inline-block; margin-top: 16px;
      font: inherit; font-size: 0.95rem; color: rgba(255, 255, 255, 0.6);
      background: none; border: none; cursor: pointer; text-decoration: none;
    }
    .cta-text:hover { color: #fff; }

    .mark-ok {
      width: 56px; height: 56px; margin: 0 auto 20px;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.6rem; color: #fff;
      border-radius: 999px; background: rgba(224, 69, 48, 0.9);
    }

    /* ── Motion ── */
    .slide-in { animation: funnelIn 0.34s cubic-bezier(0.22, 1, 0.36, 1); }
    @keyframes funnelIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
    @media (prefers-reduced-motion: reduce) {
      .slide-in { animation: none; }
      .funnel-progress-bar { transition: none; }
      .funnel { background-attachment: scroll; }
    }
  </style>
</FunnelLayout>
