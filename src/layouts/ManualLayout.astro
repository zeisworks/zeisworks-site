---
// The "assembly manual" shell. The site is typeset like an equipment spec
// sheet: one family in three cuts (IBM Plex Sans Condensed / Sans / Mono),
// paper white, ink black, warm rule grey, and the brand red used only as
// pen marks and safety callouts. No hero, no cards, no bands.
import { CALENDLY_URL } from '../config';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  docNumber: string;
  revision: string;
}
const { title, description, ogImage = '/og.png', docNumber, revision } = Astro.props;

const siteUrl = 'https://zeisworks.com';
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const resolvedOgImage = new URL(ogImage, siteUrl).href;

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'ZeisWorks',
  url: siteUrl,
  description:
    'ZeisWorks installs the FW-1 free-week funnel for independent gyms: the landing page, the ads, the one-hour coach follow-up, and the tracking that ties ad spend to members.',
  email: 'jack@zeisworks.com',
  areaServed: 'US',
  founder: { '@type': 'Person', name: 'Jack Zeis', sameAs: ['https://www.linkedin.com/in/jack-zeis/', 'https://www.upwork.com/freelancers/~01ddd112c03a2e1428'] },
  address: { '@type': 'PostalAddress', addressLocality: 'Golden', addressRegion: 'CO', addressCountry: 'US' },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#FBFAF7" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:site_name" content="ZeisWorks" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Condensed:wght@500;600;700&family=IBM+Plex+Sans:ital,wght@0,400;0,500;1,400&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
    <slot name="head" />

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-F05WB9RWJT"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-F05WB9RWJT');
    </script>
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '1416784273550486');
      fbq('track', 'PageView');
    </script>

    <style is:global>
      :root {
        --paper: #FBFAF7;
        --paper-2: #F3F1EB;
        --ink: #141414;
        --ink-2: #3A3835;
        --rule: #B9B5AD;
        --rule-soft: #DDD9D1;
        --red: #E04530;
        --red-ink: #B7301E;
        --sans: 'IBM Plex Sans', system-ui, sans-serif;
        --cond: 'IBM Plex Sans Condensed', 'IBM Plex Sans', system-ui, sans-serif;
        --mono: 'IBM Plex Mono', ui-monospace, monospace;
      }
      html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
      body.manual {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: var(--sans);
        font-size: 1rem;
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
        font-variant-numeric: tabular-nums;
      }
      .manual ::selection { background: rgba(224, 69, 48, 0.2); }
      .manual a { color: inherit; }
      .manual a:focus-visible, .manual button:focus-visible { outline: 2px solid var(--red); outline-offset: 3px; }

      /* Document type scale */
      .m-title { font-family: var(--cond); font-weight: 700; font-size: clamp(2.6rem, 6.5vw, 5.6rem); line-height: 0.95; letter-spacing: -0.01em; text-wrap: balance; margin: 0; }
      .m-h { font-family: var(--cond); font-weight: 600; font-size: clamp(1.5rem, 2.4vw, 2rem); line-height: 1.1; letter-spacing: -0.005em; margin: 0; text-wrap: balance; }
      .m-sub { font-family: var(--cond); font-weight: 600; font-size: 1.05rem; line-height: 1.2; margin: 0; }
      .m-lede { font-size: clamp(1.05rem, 1.4vw, 1.2rem); line-height: 1.5; max-width: 60ch; text-wrap: pretty; }
      .m-body { max-width: 62ch; }
      .m-mono { font-family: var(--mono); font-size: 0.8rem; letter-spacing: 0.01em; }
      .m-label { font-family: var(--mono); font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-2); }
      .m-muted { color: var(--ink-2); }
      .m-red { color: var(--red-ink); }

      /* Page frame */
      .m-page { max-width: 1240px; margin-inline: auto; padding-inline: clamp(1rem, 4vw, 3rem); }
      .m-grid { display: grid; grid-template-columns: 1fr; gap: 0 3rem; }
      @media (min-width: 1024px) { .m-grid { grid-template-columns: 11rem minmax(0, 1fr); } }
      .m-rail { display: none; }
      @media (min-width: 1024px) {
        .m-rail { display: block; position: sticky; top: 1.5rem; align-self: start; padding-top: 0.4rem; }
      }
      .m-rail ol { list-style: none; margin: 0; padding: 0; }
      .m-rail li a { display: grid; grid-template-columns: 2.4rem 1fr; gap: 0.4rem; font-family: var(--mono); font-size: 0.74rem; padding: 0.35rem 0; text-decoration: none; color: var(--ink-2); border-top: 1px solid var(--rule-soft); }
      .m-rail li a:hover, .m-rail li a[aria-current="true"] { color: var(--ink); }
      .m-rail li a span:first-child { color: var(--red-ink); }

      /* Sections read as numbered clauses of a document */
      .m-section { padding-block: clamp(2.2rem, 4vw, 3.4rem); border-top: 1px solid var(--rule); scroll-margin-top: 1rem; }
      .m-section-head { display: grid; grid-template-columns: 3.4rem 1fr; gap: 0.6rem; align-items: baseline; margin-bottom: 1.4rem; }
      .m-section-head .num { font-family: var(--mono); font-size: 0.85rem; color: var(--red-ink); }

      /* Tables: the manual's main instrument */
      .m-table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
      .m-table th, .m-table td { text-align: left; vertical-align: top; padding: 0.6rem 0.9rem 0.6rem 0; border-bottom: 1px solid var(--rule-soft); }
      .m-table th { font-family: var(--mono); font-weight: 500; font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-2); border-bottom: 1px solid var(--ink); }
      .m-table td.pn, .m-table td.qty { font-family: var(--mono); font-size: 0.8rem; white-space: nowrap; }
      .m-table td.qty { text-align: right; padding-right: 1.4rem; }
      .m-table th.qty { text-align: right; padding-right: 1.4rem; }
      .m-table-wide { min-width: 40rem; }
      .m-table tr[data-part] { cursor: default; transition: background-color 0.15s; }
      .m-table tr[data-part]:hover, .m-table tr[data-part].is-hot { background: rgba(224, 69, 48, 0.07); }
      .m-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }

      /* Figures */
      .m-fig { margin: 0; }
      .m-fig img { display: block; width: 100%; height: auto; border: 1px solid var(--rule-soft); }
      .m-fig figcaption { font-family: var(--mono); font-size: 0.74rem; color: var(--ink-2); margin-top: 0.55rem; line-height: 1.45; }
      .m-fig figcaption b { color: var(--ink); font-weight: 500; }

      /* Callouts in the manual's own vernacular */
      .m-note, .m-caution { display: grid; grid-template-columns: auto 1fr; gap: 0.9rem; padding: 0.9rem 1rem; border: 1px solid var(--ink); font-size: 0.92rem; max-width: 62ch; }
      .m-note .k, .m-caution .k { font-family: var(--mono); font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; padding-top: 0.2rem; }
      .m-caution { border-color: var(--red); border-left-width: 6px; }
      .m-caution .k { color: var(--red-ink); }

      /* Buttons: one solid, one outline */
      .manual .m-btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; min-height: 46px; padding: 0.7rem 1.2rem; font-family: var(--cond); font-weight: 600; font-size: 1rem; letter-spacing: 0.01em; text-decoration: none; border: 1.5px solid var(--ink); background: var(--ink); color: var(--paper); cursor: pointer; transition: background-color 0.15s, color 0.15s, border-color 0.15s; border-radius: 3px; }
      .manual .m-btn:hover { background: var(--red); border-color: var(--red); color: var(--paper); }
      .manual .m-btn-outline { background: transparent; color: var(--ink); }
      .manual .m-btn-outline:hover { background: var(--ink); color: var(--paper); border-color: var(--ink); }

      /* Pen marks: the only place the red is allowed to be loose */
      .pen { color: var(--red-ink); font-family: var(--mono); font-size: 0.78rem; }
      .stamp { display: inline-block; font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--red-ink); border: 1.5px solid var(--red-ink); padding: 0.2rem 0.5rem; transform: rotate(-2deg); }
      .confirm { display: inline-block; font-family: var(--mono); font-size: 0.62rem; letter-spacing: 0.14em; text-transform: uppercase; background: #FFE9B8; color: #6B4600; padding: 0.15rem 0.4rem; vertical-align: middle; }

      /* Mobile sticky order bar */
      .m-orderbar { position: fixed; inset-inline: 0; bottom: 0; z-index: 40; display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.7rem clamp(1rem, 4vw, 3rem); background: var(--paper); border-top: 1px solid var(--ink); }
      @media (min-width: 1024px) { .m-orderbar { display: none; } }
      .has-orderbar { padding-bottom: 5rem; }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .manual *, .manual *::before, .manual *::after { animation-duration: 0.001ms !important; transition-duration: 0.001ms !important; }
      }
    </style>
  </head>

  <body class="manual has-orderbar">
    <!-- Document header: what a spec sheet carries in its top rule -->
    <header class="m-page" style="padding-top: 1.1rem;">
      <div class="flex items-center justify-between gap-4 flex-wrap" style="border-bottom: 2px solid var(--ink); padding-bottom: 0.7rem;">
        <a href="/" class="flex items-center gap-2 no-underline" aria-label="ZeisWorks home">
          <span aria-hidden="true" style="display:inline-block;width:14px;height:14px;background:var(--red);"></span>
          <span style="font-family: var(--cond); font-weight: 700; font-size: 1.15rem; letter-spacing: 0.01em;">ZEISWORKS</span>
        </a>
        <div class="m-mono flex gap-5 flex-wrap" style="color: var(--ink-2);">
          <span>DOC {docNumber}</span>
          <span>REV {revision}</span>
          <span class="hidden sm:inline">GOLDEN, CO</span>
          <a href={CALENDLY_URL} class="hidden md:inline no-underline hover:underline" style="color: var(--ink);">jack@zeisworks.com</a>
        </div>
      </div>
    </header>

    <main class="m-page">
      <slot />
    </main>

    <footer class="m-page" style="padding-block: 2rem 2.5rem;">
      <div class="m-mono flex flex-wrap justify-between gap-3" style="border-top: 2px solid var(--ink); padding-top: 0.8rem; color: var(--ink-2);">
        <span>ZeisWorks · High Range Living LLC · Golden, Colorado</span>
        <span>DOC {docNumber} · REV {revision} · supersedes all prior revisions of zeisworks.com</span>
        <span><a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a></span>
      </div>
    </footer>

    <div class="m-orderbar">
      <span class="m-mono" style="color: var(--ink-2);">FW-1 · Free inspection</span>
      <a href="/start/" data-audit-cta data-cta-location="orderbar" class="m-btn" style="min-height: 42px; padding-block: 0.5rem;">Request inspection</a>
    </div>

    <script is:inline>
      // Rail: mark the section in view. Diagram ↔ parts list: shared hover.
      (function () {
        var links = document.querySelectorAll('.m-rail a[href^="#"]');
        var map = {};
        links.forEach(function (a) { var id = a.getAttribute('href').slice(1); var el = document.getElementById(id); if (el) map[id] = a; });
        if ('IntersectionObserver' in window && Object.keys(map).length) {
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) { if (e.isIntersecting) { links.forEach(function (a) { a.removeAttribute('aria-current'); }); map[e.target.id].setAttribute('aria-current', 'true'); } });
          }, { rootMargin: '-20% 0px -70% 0px' });
          Object.keys(map).forEach(function (id) { io.observe(document.getElementById(id)); });
        }
        function hot(id, on) {
          document.querySelectorAll('[data-part="' + id + '"]').forEach(function (n) { n.classList.toggle('is-hot', on); });
        }
        document.querySelectorAll('[data-part]').forEach(function (n) {
          n.addEventListener('mouseenter', function () { hot(n.getAttribute('data-part'), true); });
          n.addEventListener('mouseleave', function () { hot(n.getAttribute('data-part'), false); });
        });
        // CTA events
        document.addEventListener('click', function (e) {
          var a = e.target && e.target.closest ? e.target.closest('a[data-audit-cta]') : null;
          if (!a) return;
          var loc = a.getAttribute('data-cta-location') || 'unknown';
          if (typeof fbq === 'function') fbq('trackCustom', 'PlanStart', { cta_location: loc, page_path: location.pathname });
          if (typeof gtag === 'function') gtag('event', 'plan_start', { cta_location: loc, page_path: location.pathname, transport_type: 'beacon' });
        }, true);
      })();
    </script>
  </body>
</html>
