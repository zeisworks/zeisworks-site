---
import AuditCta from '../components/AuditCta.astro';
import Logo from '../components/Logo.astro';
import MotionScripts from '../components/MotionScripts.astro';
import { CALENDLY_URL } from '../config';
import { FOOTER_GROUPS } from '../data/footer';

// Dedicated layout for the single-page AI-readiness rebuild (dev prompt).
// Kept separate from BaseLayout so the new cream/forest/teal brand, the
// four-link anchor nav, and the minimal footer do not disturb the existing
// guide, pricing, about, vertical, and legal pages.
interface Props {
  title: string;
  description: string;
  ogImage?: string;
  navLinks?: { label: string; href: string }[];
  ctaLabel?: string;
  /** Brand/footer logo target; segment pages pass "/" since #top is homepage-only. */
  brandHref?: string;
}

const {
  title,
  description,
  ogImage,
  navLinks = [
    { label: 'See it working', href: '#demo' },
    { label: 'How it works', href: '#how-it-works' },
    { label: 'Proof', href: '#proof' },
    { label: 'Pricing', href: '#pricing' },
  ],
  ctaLabel = 'See what this looks like',
  brandHref = '#top',
} = Astro.props;

const siteUrl = 'https://zeisworks.com';
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const resolvedOgImage = ogImage ? new URL(ogImage, siteUrl).href : undefined;

// Organization schema aligned to the AI-readiness positioning.
const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'ZeisWorks',
  url: siteUrl,
  logo: `${siteUrl}/favicon.svg`,
  description:
    'ZeisWorks writes your business down in plain language your team and your AI can both read, then builds the AI assistants and automations that run on it, so when the AI is wrong you can see why and fix it.',
  email: 'jack@zeisworks.com',
  founder: {
    '@type': 'Person',
    name: 'Jack Zeis',
    jobTitle: 'Systems Consultant',
    url: siteUrl,
    sameAs: [
      'https://www.linkedin.com/in/jack-zeis/',
      'https://www.upwork.com/freelancers/~01ddd112c03a2e1428',
    ],
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Golden',
    addressRegion: 'CO',
    addressCountry: 'US',
  },
  parentOrganization: {
    '@type': 'Organization',
    name: 'High Range Living LLC',
  },
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1D1D1F" />
    <meta name="description" content={description} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {resolvedOgImage && <meta property="og:image" content={resolvedOgImage} />}
    <meta property="og:site_name" content="ZeisWorks" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {resolvedOgImage && <meta name="twitter:image" content={resolvedOgImage} />}

    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=DM+Sans:wght@300;400;500;600;700&family=DM+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="256x256" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />

    <slot name="head" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-F05WB9RWJT"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-F05WB9RWJT');
    </script>

    <!-- Meta Pixel Base Code -->
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '1416784273550486');
      fbq('track', 'PageView');
    </script>
    <noscript><img height="1" width="1" style="display:none"
      src="https://www.facebook.com/tr?id=1416784273550486&ev=PageView&noscript=1"
    /></noscript>
    <!-- End Meta Pixel Base Code -->

    <style is:global>
      :root {
        /* Apple-inspired palette (achromatic neutrals + single brand-red accent). */
        --zw-cream: #F7F6F3;
        --zw-ink: #1D1D1F;
        --zw-forest: #1D1D1F;
        --zw-forest-deep: #141416;
        --zw-forest-darkest: #000000;
        --zw-teal: #C83A25;
        --zw-rust: #A93409;
        --zw-rust-soft: #F0A184;
        --zw-card: #FFFFFF;
        --zw-border: rgba(0, 0, 0, 0.10);
        --zw-muted: #5D5D63;
        --zw-ease: cubic-bezier(0.22, 1, 0.36, 1);
      }

      html { -webkit-text-size-adjust: 100%; }

      body.zw-root {
        background: var(--zw-cream);
        color: var(--zw-ink);
        font-family: 'DM Sans', system-ui, sans-serif;
        font-size: 1.0625rem;
        line-height: 1.7;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      .zw-root ::selection { background: rgba(224, 69, 48, 0.18); }

      /* Fluid type scale (section 3). */
      .zw-h1 {
        font-family: 'Space Grotesk', 'DM Sans', system-ui, sans-serif;
        font-weight: 600;
        font-size: clamp(2.4rem, 5.4vw, 4rem);
        line-height: 1.05;
        letter-spacing: -0.03em;
        text-wrap: balance;
      }
      .zw-h2 {
        font-family: 'Space Grotesk', 'DM Sans', system-ui, sans-serif;
        font-weight: 600;
        font-size: clamp(1.8rem, 3.6vw, 2.75rem);
        line-height: 1.08;
        letter-spacing: -0.02em;
      }
      .zw-h3 {
        font-family: 'DM Sans', system-ui, sans-serif;
        font-weight: 600;
        font-size: 1.25rem;
        line-height: 1.3;
      }
      .zw-eyebrow {
        font-family: 'DM Mono', ui-monospace, monospace;
        font-weight: 500;
        font-size: 0.75rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--zw-teal);
      }
      .zw-section {
        padding-top: clamp(4rem, 9vw, 8rem);
        padding-bottom: clamp(4rem, 9vw, 8rem);
      }
      .zw-wrap { max-width: 1080px; margin-inline: auto; }
      .zw-mono { font-family: 'DM Mono', ui-monospace, monospace; }
      .zw-anchor { scroll-margin-top: 5rem; }

      /* Full-bleed hairline section rule: structure instead of background
         swaps. (Own implementation of a section-divider idiom.) */
      .zw-rule-t { position: relative; }
      .zw-rule-t::before {
        content: "";
        position: absolute;
        top: 0;
        left: -100vw;
        width: 200vw;
        height: 1px;
        background: var(--zw-border);
      }

      /* Small heading rung between h3 and h2, for card-group heads. */
      .zw-h2-sm {
        font-family: 'Space Grotesk', 'DM Sans', system-ui, sans-serif;
        font-weight: 600;
        font-size: clamp(1.35rem, 2.2vw, 1.7rem);
        line-height: 1.2;
      }

      /* Content measures. Rule: never put a max-w-* utility on the same
         element as .zw-wrap — the utilities live in per-page CSS chunks whose
         order against this file is not guaranteed, so the caps silently lose
         the cascade. Wrap sections as:
           <div class="zw-wrap px-5 sm:px-8"><div class="zw-measure">…</div></div>
         These are defined HERE, next to .zw-wrap, so order can never flip. */
      .zw-measure { max-width: 760px; }
      .zw-measure-wide { max-width: 820px; }

      /* Hero lede + shared hero top padding (one recipe for all heroes). */
      .zw-lede {
        font-size: clamp(1.05rem, 1.6vw, 1.2rem);
        line-height: 1.6;
        color: var(--zw-muted);
        text-wrap: pretty;
      }
      .zw-hero-pad { padding-top: clamp(6.5rem, 12vw, 9.5rem); }

      /* Eyebrow variant for dark (forest) sections. */
      .zw-eyebrow-dark { color: var(--zw-rust-soft); }

      /* Card surfaces (radius 14px), shared across pages. */
      .zw-card {
        background: var(--zw-card);
        border: 1px solid var(--zw-border);
        border-radius: 12px;
        padding: 1.6rem;
      }
      .zw-card-dark {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 12px;
        padding: 1.75rem;
      }
      .zw-card-dark-compact { padding: 1.3rem 1.3rem 1.4rem; }

      /* Anti-positioning strip. */
      .zw-strip {
        padding-top: clamp(3rem, 6vw, 4.5rem);
        padding-bottom: clamp(3rem, 6vw, 4.5rem);
      }
      .zw-strip-line {
        font-family: 'Space Grotesk', 'DM Sans', system-ui, sans-serif;
        font-weight: 500;
        font-size: clamp(1.2rem, 2.4vw, 1.6rem);
        line-height: 1.4;
        text-wrap: balance;
        max-width: 46ch;
        margin-inline: auto;
      }

      /* Visible, keyboard-reachable focus in --teal (section 7). */
      .zw-root a:focus-visible,
      .zw-root button:focus-visible {
        outline: 2px solid var(--zw-teal);
        outline-offset: 3px;
        border-radius: 4px;
      }

      /* Scroll-reveal baseline. Hidden state only applies when motion is OK
         and JS has marked the document ready; otherwise content is visible. */
      .zw-reveal { opacity: 1; transform: none; }
      html.zw-anim .zw-reveal {
        opacity: 0;
        transform: translateY(22px);
        filter: blur(8px);
        transition:
          opacity 0.85s var(--zw-ease),
          transform 0.85s var(--zw-ease),
          filter 0.85s var(--zw-ease);
        will-change: opacity, transform;
      }
      html.zw-anim .zw-reveal.zw-in { opacity: 1; transform: none; filter: none; }
      /* Mobile: never hide content behind the reveal system. */
      @media (max-width: 767px) {
        html.zw-anim .zw-reveal { opacity: 1; transform: none; filter: none; transition: none; }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .zw-root *, .zw-root *::before, .zw-root *::after {
          animation-duration: 0.001ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.001ms !important;
        }
      }
    </style>
  </head>
  <body class="zw-root min-h-screen flex flex-col">
    <!-- Sentinel: when it scrolls out of view the nav gains its solid state. -->
    <div id="zw-top-sentinel" aria-hidden="true" style="position:absolute;top:0;height:8px;width:1px;"></div>

    <header
      id="zw-nav"
      class="fixed top-0 inset-x-0 z-50 transition-colors duration-300"
    >
      <div class="zw-wrap px-5 sm:px-8 h-16 flex items-center justify-between">
        <a href={brandHref} class="flex items-center gap-2.5 group" aria-label="ZeisWorks home">
          <Logo class="w-8 h-8 rounded-[7px]" />
          <span class="font-serif text-xl font-semibold tracking-tight text-zw-ink">zeisWorks<span class="text-zw-teal">.</span></span>
        </a>

        <nav class="hidden md:flex items-center gap-8 text-sm font-medium" aria-label="Primary">
          {navLinks.map(({ label, href }) => (
            <a href={href} class="text-zw-ink/75 hover:text-zw-teal transition-colors">{label}</a>
          ))}
          <AuditCta
            location="nav"
            label={ctaLabel}
            class="bg-zw-teal text-white text-sm font-semibold px-4 py-2 rounded-full hover:bg-zw-rust transition-colors"
          />
        </nav>

        <!-- Mobile: keep a visible conversion action next to the hamburger —
             previously the header had no CTA at all below md. -->
        <div class="md:hidden flex items-center gap-2">
          <AuditCta
            location="nav"
            label={ctaLabel}
            class="bg-zw-teal text-white text-sm font-semibold px-3.5 py-1.5 rounded-full hover:bg-zw-rust transition-colors"
          />
          <button
            id="zw-menu-btn"
            class="flex flex-col justify-center gap-[5px] w-10 h-10 -mr-2"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="zw-mobile-menu"
          >
            <span class="block w-6 h-[2px] bg-zw-ink rounded transition-transform"></span>
            <span class="block w-6 h-[2px] bg-zw-ink rounded transition-opacity"></span>
            <span class="block w-6 h-[2px] bg-zw-ink rounded transition-transform"></span>
          </button>
        </div>
      </div>
    </header>

    <!-- Mobile full-height menu -->
    <div
      id="zw-mobile-menu"
      class="fixed inset-0 z-40 bg-zw-cream flex-col justify-center px-8 hidden"
    >
      <nav class="flex flex-col gap-2 text-center" aria-label="Mobile">
        {navLinks.map(({ label, href }) => (
          <a href={href} class="zw-mobile-link font-serif text-3xl py-3 text-zw-ink hover:text-zw-teal transition-colors">{label}</a>
        ))}
        <AuditCta
          location="nav"
          label={ctaLabel}
          class="zw-mobile-link mt-6 inline-block bg-zw-teal text-white font-semibold text-lg px-7 py-3.5 rounded-full hover:bg-zw-rust transition-colors"
        />
      </nav>
    </div>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="bg-zw-forest text-zw-cream" style="border-top: 1px solid rgba(245, 245, 247, 0.14);">
      <div class="zw-wrap px-5 sm:px-8 py-14">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">
          <div>
            <a href={brandHref} class="flex items-center gap-2.5" aria-label="ZeisWorks home">
              <Logo class="w-8 h-8 rounded-[7px]" />
              <span class="font-serif text-xl font-semibold tracking-tight">zeisWorks<span class="text-zw-teal">.</span></span>
            </a>
            <p class="mt-4 text-sm text-zw-cream/60 leading-relaxed max-w-[32ch]">
              Your business, written down where your team and your AI both read it.
            </p>
          </div>
          {FOOTER_GROUPS.map((group) => (
            <div>
              <p class="font-serif font-semibold mb-3">{group.heading}</p>
              <ul class="space-y-2 text-sm text-zw-cream/70">
                {group.links.map(({ label, href }) => (
                  <li><a href={href} class="hover:text-white transition-colors">{label}</a></li>
                ))}
              </ul>
            </div>
          ))}
          <div>
            <p class="font-serif font-semibold mb-3">Contact</p>
            <ul class="space-y-2 text-sm text-zw-cream/70">
              <li><a href="mailto:jack@zeisworks.com" class="hover:text-white transition-colors">jack@zeisworks.com</a></li>
              <li><a href={CALENDLY_URL} class="hover:text-white transition-colors">Book 15 minutes</a></li>
            </ul>
          </div>
        </div>
        <div class="mt-12 pt-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 text-xs text-zw-cream/50" style="border-top: 1px solid rgba(245, 245, 247, 0.12);">
          <p>&copy; {new Date().getFullYear()} ZeisWorks, a High Range Living LLC company.</p>
          <p class="flex gap-3 zw-mono">
            <a href="/privacy" class="hover:text-zw-cream/80 transition-colors">Privacy</a>
            <span aria-hidden="true">&middot;</span>
            <a href="/terms" class="hover:text-zw-cream/80 transition-colors">Terms</a>
          </p>
        </div>
      </div>
    </footer>

    <!-- Premium-motion layer: magnetic CTAs + parallax. The homepage runs its
         own zw-reveal scroll system, so opt out of the shared auto-reveal. -->
    <MotionScripts reveal={false} />

    <!-- Nav state, mobile menu, smooth-anchor offset, and the scroll-reveal /
         animation controller. Vanilla JS to keep the JS budget small; every
         motion path is gated behind prefers-reduced-motion. -->
    <script is:inline>
      (function () {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

        // ── Nav solid-on-scroll ──
        var nav = document.getElementById('zw-nav');
        var sentinel = document.getElementById('zw-top-sentinel');
        if (nav && sentinel && 'IntersectionObserver' in window) {
          var navObs = new IntersectionObserver(function (entries) {
            var atTop = entries[0].isIntersecting;
            nav.classList.toggle('zw-nav-solid', !atTop);
          });
          navObs.observe(sentinel);
        } else if (nav) {
          nav.classList.add('zw-nav-solid');
        }

        // ── Mobile menu ──
        var btn = document.getElementById('zw-menu-btn');
        var menu = document.getElementById('zw-mobile-menu');
        function closeMenu() {
          if (!menu || !btn) return;
          menu.classList.add('hidden');
          menu.classList.remove('flex');
          btn.setAttribute('aria-expanded', 'false');
          btn.classList.remove('zw-menu-open');
          document.body.style.overflow = '';
        }
        if (btn && menu) {
          btn.addEventListener('click', function () {
            var isOpen = !menu.classList.contains('hidden');
            if (isOpen) { closeMenu(); return; }
            menu.classList.remove('hidden');
            menu.classList.add('flex');
            btn.setAttribute('aria-expanded', 'true');
            btn.classList.add('zw-menu-open');
            document.body.style.overflow = 'hidden';
          });
          menu.querySelectorAll('.zw-mobile-link').forEach(function (l) {
            l.addEventListener('click', closeMenu);
          });
          document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closeMenu();
          });
        }

        // ── Scroll-reveal + per-animation triggers ──
        if (reduce.matches || !('IntersectionObserver' in window)) {
          // Reduced motion / no IO: leave everything in its resting end state.
          return;
        }
        document.documentElement.classList.add('zw-anim');

        var revealObs = new IntersectionObserver(function (entries, obs) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('zw-in');
            // Fire any named animation hook attached to this element.
            var hook = entry.target.getAttribute('data-anim');
            if (hook) entry.target.classList.add('zw-play');
            obs.unobserve(entry.target);
          });
        }, { threshold: 0.2, rootMargin: '0px 0px -8% 0px' });

        document.querySelectorAll('.zw-reveal, [data-anim]').forEach(function (el) {
          revealObs.observe(el);
        });

        // ── Animation A (hero): play on load, not on scroll ──
        var heroAnim = document.querySelector('[data-anim="hero"]');
        if (heroAnim) {
          requestAnimationFrame(function () {
            requestAnimationFrame(function () { heroAnim.classList.add('zw-play'); });
          });
        }

        // ── Animation D (why it lasts): cycle the model chip ──
        var swap = document.querySelector('[data-anim="model-swap"]');
        if (swap) {
          var chips = swap.querySelectorAll('.zw-model-chip');
          if (chips.length > 1) {
            var i = 0;
            var swapTimer = null;
            var startSwap = function () {
              if (swapTimer) return;
              swapTimer = setInterval(function () {
                chips[i].classList.remove('zw-chip-on');
                i = (i + 1) % chips.length;
                chips[i].classList.add('zw-chip-on');
              }, 2500);
            };
            var swapObs = new IntersectionObserver(function (entries) {
              entries.forEach(function (e) {
                if (e.isIntersecting) startSwap();
                else if (swapTimer) { clearInterval(swapTimer); swapTimer = null; }
              });
            }, { threshold: 0.3 });
            swapObs.observe(swap);
          }
        }
      })();
    </script>

    <!-- Audit CTA tracking + UTM passthrough (carried from the prior build). -->
    <script is:inline>
      (function () {
        var UTM_KEYS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content'];
        var stored = {};
        try { stored = JSON.parse(sessionStorage.getItem('zw_utm') || '{}'); } catch (e) {}
        var params = new URLSearchParams(window.location.search);
        UTM_KEYS.forEach(function (k) { var v = params.get(k); if (v) stored[k] = v; });
        try { sessionStorage.setItem('zw_utm', JSON.stringify(stored)); } catch (e) {}

        if (Object.keys(stored).length) {
          document.querySelectorAll('a[data-audit-cta]').forEach(function (link) {
            try {
              var url = new URL(link.getAttribute('href'), window.location.origin);
              UTM_KEYS.forEach(function (k) { if (stored[k]) url.searchParams.set(k, stored[k]); });
              link.setAttribute('href', url.href);
            } catch (e) {}
          });
        }

        document.addEventListener('click', function (e) {
          var link = e.target && e.target.closest ? e.target.closest('a[data-audit-cta]') : null;
          if (!link) return;
          var ctaLocation = link.getAttribute('data-cta-location') || 'unknown';
          var pagePath = window.location.pathname;
          try { sessionStorage.setItem('zw_cta_clicked', '1'); } catch (err) {}
          if (typeof fbq === 'function') {
            fbq('trackCustom', 'AuditStart', { cta_location: ctaLocation, page_path: pagePath });
          }
          if (typeof gtag === 'function') {
            gtag('event', 'audit_start', { cta_location: ctaLocation, page_path: pagePath, transport_type: 'beacon' });
          }
        }, true);
      })();
    </script>
  </body>
</html>

<style is:global>
  /* Nav resting (transparent over hero) and solid (scrolled) states. */
  #zw-nav { background: transparent; }
  #zw-nav.zw-nav-solid {
    background: rgba(245, 245, 247, 0.97);
    border-bottom: 1px solid var(--zw-border);
  }
  @media (min-width: 768px) {
    #zw-nav.zw-nav-solid {
      background: rgba(245, 245, 247, 0.92);
      backdrop-filter: saturate(140%) blur(8px);
    }
  }
  /* Hamburger to X when the menu is open. */
  #zw-menu-btn.zw-menu-open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  #zw-menu-btn.zw-menu-open span:nth-child(2) { opacity: 0; }
  #zw-menu-btn.zw-menu-open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
</style>
