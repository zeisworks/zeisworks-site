---
import AuditCta from '../components/AuditCta.astro';
import ExitIntentModal from '../components/ExitIntentModal.astro';
import MotionScripts from '../components/MotionScripts.astro';
import { CALENDLY_URL } from '../config';
import { FOOTER_GROUPS } from '../data/footer';

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  canonicalUrl?: string;
  bodyPage?: string;
  businessSchema?: boolean;
}

const {
  title,
  description,
  ogTitle,
  ogDescription,
  ogImage = '/og.png',
  canonicalUrl,
  bodyPage,
  businessSchema = false,
} = Astro.props;

const siteUrl = 'https://zeisworks.com';
const canonical = canonicalUrl ?? new URL(Astro.url.pathname, siteUrl).href;
const resolvedOgImage = ogImage ? new URL(ogImage, siteUrl).href : undefined;

// LocalBusiness/ProfessionalService schema, rendered on the homepage and
// about page only (handoff section 5, vertical page schema note).
const localBusinessJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'ZeisWorks',
  url: siteUrl,
  logo: `${siteUrl}/favicon.svg`,
  description:
    'ZeisWorks builds VIKs — Visualized Institutional Knowledge: living systems that hold how a business runs and do work with it, so the knowledge stays when key people leave.',
  email: 'jack@zeisworks.com',
  founder: {
    '@type': 'Person',
    name: 'Jack Zeis',
    jobTitle: 'Systems Consultant',
    url: siteUrl,
    sameAs: [
      'https://www.linkedin.com/in/jack-zeis/',
      'https://www.upwork.com/freelancers/~01ddd112c03a2e1428',
    ],
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Golden',
    addressRegion: 'CO',
    addressCountry: 'US',
  },
  parentOrganization: {
    '@type': 'Organization',
    name: 'High Range Living LLC',
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'ZeisWorks Services',
    itemListElement: [
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'VIK — Visualized Institutional Knowledge' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Institutional Knowledge Capture' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'AI Assistants and Automations' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Systems Consulting' } },
    ],
  },
};

const navLinks = [
  { label: 'How It Works', href: '/#how-it-works' },
  { label: 'Proof', href: '/results/' },
  { label: 'Pricing', href: '/pricing/' },
  { label: 'About', href: '/about/' },
];
---

<!doctype html>
<html lang="en" class="bg-cream text-ink scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F7F6F3" />
    <meta name="description" content={description} />

    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={ogDescription ?? description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {resolvedOgImage && <meta property="og:image" content={resolvedOgImage} />}
    <meta property="og:site_name" content="ZeisWorks" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle ?? title} />
    <meta name="twitter:description" content={ogDescription ?? description} />
    {resolvedOgImage && <meta name="twitter:image" content={resolvedOgImage} />}

    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=DM+Sans:wght@300;400;500;600;700&family=DM+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-F05WB9RWJT"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-F05WB9RWJT');
    </script>

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="256x256" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    {businessSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(localBusinessJsonLd)} />
    )}
    <slot name="head" />

    <!-- ContentSquare UX Analytics -->
    <script src="https://t.contentsquare.net/uxa/2a5f9e9b31741.js" async></script>

    <!-- Meta Pixel Base Code -->
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '1416784273550486');
      fbq('track', 'PageView');
    </script>
    <noscript><img height="1" width="1" style="display:none"
      src="https://www.facebook.com/tr?id=1416784273550486&ev=PageView&noscript=1"
    /></noscript>
    <!-- End Meta Pixel Base Code -->

    <style is:global>
      :root {
        --ink: #1D1D1F;
        --ink-mid: #5D5D63;
        --ink-light: #86868B;
        --cream: #F7F6F3;
        --cream-dark: #E8E8ED;
        /* Apple-inspired palette — navy/forest aliases repointed to the
           brand-red accent + near-black dark stage so inline-styled pages reskin
           without per-file edits. */
        --navy: #C2410C;
        --navy-deep: #1D1D1F;
        --forest: #1D1D1F;
        --forest-deep: #141416;
        --forest-darkest: #000000;
        --orange: #C83A25;
        --orange-bright: #A93409;
        --rust-soft: #F0A184;
        --font-serif: 'Space Grotesk', 'DM Sans', system-ui, sans-serif;
        --font-sans: 'DM Sans', system-ui, sans-serif;
        --font-mono: 'DM Mono', monospace;
      }

    </style>
  </head>
  <body class="font-sans antialiased min-h-screen flex flex-col" data-page={bodyPage}>
    <header class="border-b border-cream-dark sticky top-0 bg-cream/95 backdrop-blur-sm z-50">
      <div class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between gap-4">
        <a
          href="/"
          class="font-serif text-xl font-semibold text-ink hover:text-navy transition-colors"
        >
          zeisWorks<span class="text-orange">.</span>
        </a>
        <!-- Desktop nav -->
        <nav class="hidden md:flex items-center gap-6 text-sm">
          {navLinks.map(({ label, href }) => (
            <a href={href} class="text-ink-mid hover:text-ink transition-colors">{label}</a>
          ))}
          <AuditCta
            location="nav"
            label="Get started"
            class="bg-orange text-white text-sm px-4 py-2 rounded-full hover:bg-orange-bright transition-colors font-semibold"
          />
        </nav>
        <!-- Mobile: persistent CTA + hamburger -->
        <div class="flex md:hidden items-center gap-3">
          <AuditCta
            location="nav"
            label="Get started"
            class="bg-orange text-white text-sm px-3.5 py-2 rounded-full hover:bg-orange-bright transition-colors font-semibold whitespace-nowrap"
          />
          <button
            id="mobileMenuBtn"
            class="flex flex-col justify-center gap-[5px] w-9 h-9 p-1 rounded-lg hover:bg-cream-dark transition-colors"
            aria-label="Open menu"
            aria-expanded="false"
          >
            <span class="block w-[22px] h-[2px] bg-ink rounded"></span>
            <span class="block w-[22px] h-[2px] bg-ink rounded"></span>
            <span class="block w-[22px] h-[2px] bg-ink rounded"></span>
          </button>
        </div>
      </div>
      <!-- Mobile menu drawer -->
      <div id="mobileMenu" class="hidden md:hidden border-t border-cream-dark bg-cream px-6 pb-5 pt-2">
        <nav class="flex flex-col">
          {navLinks.map(({ label, href }) => (
            <a href={href} class="mobile-nav-link py-3 border-b border-cream-dark text-ink-mid hover:text-ink transition-colors text-sm">{label}</a>
          ))}
        </nav>
      </div>
    </header>

    <script is:inline>
      (function () {
        var btn = document.getElementById('mobileMenuBtn');
        var menu = document.getElementById('mobileMenu');
        if (!btn || !menu) return;
        btn.addEventListener('click', function () {
          var open = menu.classList.toggle('hidden');
          btn.setAttribute('aria-expanded', String(!open));
        });
        menu.querySelectorAll('.mobile-nav-link').forEach(function (link) {
          link.addEventListener('click', function () {
            menu.classList.add('hidden');
            btn.setAttribute('aria-expanded', 'false');
          });
        });
        document.addEventListener('click', function (e) {
          if (!btn.contains(e.target) && !menu.contains(e.target)) {
            menu.classList.add('hidden');
            btn.setAttribute('aria-expanded', 'false');
          }
        });
      })();
    </script>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-cream-dark mt-24">
      <div class="max-w-5xl mx-auto px-6 py-12">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-10">
          {FOOTER_GROUPS.map((group) => (
            <div>
              <p class="font-serif font-semibold text-ink mb-3">{group.heading}</p>
              <ul class="space-y-2 text-sm text-ink-mid">
                {group.links.map(({ label, href }) => (
                  <li><a href={href} class="hover:text-ink transition-colors">{label}</a></li>
                ))}
              </ul>
            </div>
          ))}
          <div>
            <p class="font-serif font-semibold text-ink mb-3">Contact</p>
            <p class="text-sm text-ink-mid leading-relaxed">
              <a href="mailto:jack@zeisworks.com" class="hover:text-ink transition-colors">jack@zeisworks.com</a>
            </p>
            <p class="text-sm text-ink-mid leading-relaxed mt-2">
              Prefer to talk first?
              <a href={CALENDLY_URL} class="text-navy font-medium hover:underline">Book 15 minutes.</a>
            </p>
          </div>
        </div>
        <div class="mt-10 pt-6 border-t border-cream-dark flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 text-sm text-ink-mid">
          <p>&copy; {new Date().getFullYear()} ZeisWorks, a High Range Living LLC company.</p>
          <p class="flex gap-3 text-xs" style="font-family:'DM Mono',monospace;letter-spacing:0.04em;">
            <a href="/privacy" class="text-ink-light hover:text-ink-mid transition-colors">Privacy</a>
            <span class="text-ink-light" aria-hidden="true">&middot;</span>
            <a href="/terms" class="text-ink-light hover:text-ink-mid transition-colors">Terms</a>
          </p>
        </div>
      </div>
    </footer>

    <ExitIntentModal />

    <MotionScripts />

    <!-- Audit CTA tracking + UTM passthrough (handoff sections 2.3 and 2.5) -->
    <script is:inline>
      (function () {
        var UTM_KEYS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content'];

        // Capture inbound UTM parameters and persist them for the session.
        var stored = {};
        try { stored = JSON.parse(sessionStorage.getItem('zw_utm') || '{}'); } catch (e) {}
        var params = new URLSearchParams(window.location.search);
        UTM_KEYS.forEach(function (k) {
          var v = params.get(k);
          if (v) stored[k] = v;
        });
        try { sessionStorage.setItem('zw_utm', JSON.stringify(stored)); } catch (e) {}

        // Preserve UTMs on every outbound funnel link.
        if (Object.keys(stored).length) {
          document.querySelectorAll('a[data-audit-cta]').forEach(function (link) {
            try {
              var url = new URL(link.getAttribute('href'), window.location.origin);
              UTM_KEYS.forEach(function (k) {
                if (stored[k]) url.searchParams.set(k, stored[k]);
              });
              link.setAttribute('href', url.href);
            } catch (e) {}
          });
        }

        // Fire AuditStart (Meta) and audit_start (GA4) on any audit CTA click.
        document.addEventListener('click', function (e) {
          var link = e.target && e.target.closest ? e.target.closest('a[data-audit-cta]') : null;
          if (!link) return;
          var ctaLocation = link.getAttribute('data-cta-location') || 'unknown';
          var pagePath = window.location.pathname;
          try { sessionStorage.setItem('zw_cta_clicked', '1'); } catch (err) {}
          if (typeof fbq === 'function') {
            fbq('trackCustom', 'AuditStart', {
              cta_location: ctaLocation,
              page_path: pagePath,
            });
          }
          if (typeof gtag === 'function') {
            gtag('event', 'audit_start', {
              cta_location: ctaLocation,
              page_path: pagePath,
              transport_type: 'beacon',
            });
          }
        }, true);
      })();
    </script>
  </body>
</html>
